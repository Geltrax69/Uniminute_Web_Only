package product

// info.templ — the info column of DetailsScreen: name (the desktop h1),
// price, unit line, availability, ratings, the delivery and payment card, the
// quantity stepper, option pickers, "About this product", and the other local
// vendors selling the same thing. Quantity-driven text reads the Alpine buy
// state declared on the page.

import (
	"encoding/json"
	"net/url"
	"strconv"

	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/ui"
)

templ Info(p backend.Product, rv backend.ProductReviews) {
	<div class="px-5 pb-9 pt-4 min-[900px]:px-8 min-[900px]:pt-9">
		<div class="hidden min-[900px]:block">
			@StoreAndReviews(p, rv)
		</div>
		<h1 class="mt-1 hidden text-[26px] font-normal leading-[1.35] text-text min-[900px]:block">{ p.Name }</h1>
		@Price(p)
		<p class="mt-2 text-[15px] leading-[22px] text-muted" x-show="qty > 1 || missing" x-cloak x-text="qty === 1 ? (missing ? 'From ₹' : '₹') + unit + (missing ? '' : ' each') : qty + ' × ₹' + unit">From ₹{ shop.Money(p.Price) }</p>
		<p class="mt-4 text-[15px] font-semibold leading-[22px] text-strong">{ availability(p) }</p>
		<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-track pt-6">
			<span class="text-[16px] font-semibold text-text">Quantity</span>
			@Stepper()
		</div>
		for _, opt := range p.Choices() {
			if len(opt.Values) > 0 {
				@optionPicker(opt)
			}
		}
		<h2 class="editorial-heading mt-10 text-[29px] text-text">About this product</h2>
		<p class="mt-3 max-w-[65ch] whitespace-pre-line text-[16px] leading-[1.6] text-muted">{ description(p) }</p>
		<section id="reviews" class="mt-10 scroll-mt-24">
			<h2 class="text-[22px] font-semibold text-text">Customer reviews</h2>
			@ReviewSummary(rv)
			if len(rv.Reviews) == 0 {
				<p class="mt-2 text-[15px] leading-6 text-muted">No written reviews yet. Reviews from completed orders will appear here.</p>
			}
			if len(rv.Reviews) > 0 {
				for _, r := range rv.Reviews {
					<div class="mt-3 rounded-small bg-surface p-3.5 shadow-surface">
						<div class="flex items-center gap-2">
							@ui.Stars(r.Rating, "text-[15px]")
							<span class="text-[13px] font-semibold text-text">{ r.Name }</span>
							<span class="text-[12px] text-muted">· { r.At.Format("2 Jan 2006") }</span>
						</div>
						if r.Text != "" {
							<p class="mt-1.5 whitespace-pre-line text-[14px] leading-[1.5] text-text">{ r.Text }</p>
						}
					</div>
				}
			}
		</section>
		if len(p.Offers) > 0 {
			@offers(p)
		}
	</div>
}

// StoreAndReviews keeps seller identity and real customer feedback prominent.
templ StoreAndReviews(p backend.Product, rv backend.ProductReviews) {
	<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
		if p.Store != "" {
			<a href={ templ.SafeURL("/store/" + url.PathEscape(p.Store)) } class="inline-flex min-h-touch min-w-0 flex-1 items-center text-[14px] font-medium leading-5 text-strong underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-strong"><span class="line-clamp-2">Visit { p.Store }</span></a>
		}
		@ReviewSummary(rv)
	</div>
}

templ ReviewSummary(rv backend.ProductReviews) {
	if rv.Count > 0 {
		<a href="#reviews" aria-label={ strconv.FormatFloat(rv.Average, 'f', 1, 64) + " out of 5 stars, " + strconv.Itoa(rv.Count) + " ratings. Read reviews" } class="inline-flex min-h-touch shrink-0 items-center gap-1 text-[13px] text-strong hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-strong">
			<span>{ strconv.FormatFloat(rv.Average, 'f', 1, 64) }</span>
			@ui.Stars(int(rv.Average+0.5), "text-[14px]")
			<span>({ strconv.Itoa(rv.Count) })</span>
		</a>
	} else {
		<a href="#reviews" class="inline-flex min-h-touch shrink-0 items-center text-[13px] text-muted underline-offset-2 hover:underline">No reviews yet</a>
	}
}

// optionPicker is _OptionPicker: labelled chips, or swatches for a colour
// group. Nothing is preselected; the pick lives in the page's buy state and
// goes into the cart with the product.
templ optionPicker(opt backend.ItemOption) {
	{{ key := jsLit(opt.Name) }}
	<div class="pt-6">
		<div class="flex items-center">
			<span class="text-[15px] font-bold text-text">{ opt.Name }</span>
			<span class="ml-2 text-[13px] text-muted" x-text={ jsLit(choiceLabels(opt)) + "[picks[" + key + "]] || ''" }></span>
		</div>
		<div class="mt-3 flex flex-wrap gap-2.5" role="radiogroup" aria-label={ opt.Name }>
			for _, v := range opt.Values {
				<button
					type="button"
					role="radio"
					x-bind:aria-checked={ "picks[" + key + "] === " + jsLit(v) }
					x-on:click={ "picks[" + key + "] = " + jsLit(v) }
					class="flex h-8 items-center rounded-lg bg-surface px-3 text-[13px] font-semibold text-text ring-strong transition-colors"
					x-bind:class={ "picks[" + key + "] === " + jsLit(v) + " ? '!bg-lime ring-2' : ''" }
				>
					if opt.IsColour() {
						{{ name, hex := shop.ColourParts(v) }}
						<span class="-ml-1 mr-2 h-[18px] w-[18px] rounded-full border border-black/10" style={ templ.SafeCSS("background-color:" + hex) }></span>
						{ name }
					} else {
						{ v }
					}
				</button>
			}
		</div>
	</div>
}

// choiceLabels maps each value to what the buyer reads (a colour's name).
func choiceLabels(opt backend.ItemOption) map[string]string {
	out := map[string]string{}
	for _, v := range opt.Values {
		out[v] = shop.ChoiceLabel(v)
	}
	return out
}

// offers is _compareSection: the same product at other local shops.
templ offers(p backend.Product) {
	<div class="mt-10 flex items-center">
		<h2 class="editorial-heading min-w-0 flex-1 text-[29px] text-text">Local vendors</h2>
		<span class="ml-2.5">
			@ui.ActionButton("Compare all", false, templ.Attributes{"href": "/compare/" + p.ID})
		</span>
	</div>
	<p class="mt-0.5 text-[12px] text-muted">Compared with ₹{ shop.Money(p.Price) } at { p.Store }</p>
	<div class="mt-2.5">
		for _, o := range p.Offers {
			<div class="mb-2.5 flex items-center rounded-small bg-surface px-3 py-2.5 shadow-surface">
				<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-track text-strong">
					@ui.Icon("store", "h-[18px] w-[18px]")
				</span>
				<div class="ml-3 min-w-0 flex-1">
					<p class="truncate text-[13px] font-bold text-text">{ o.Store }</p>
					<p class="text-[11px] text-muted">Same product</p>
				</div>
				<div class="ml-2 text-right">
					<p class="text-[13px] font-bold text-text">₹{ shop.Money(o.Price) }</p>
					{{ label, class := priceDiff(o.Price - p.Price) }}
					<p class={ "text-[11px] font-semibold " + class }>{ label }</p>
				</div>
			</div>
		}
	</div>
}

func availability(p backend.Product) string {
	switch {
	case p.AvailableStock == nil:
		return "Availability confirmed at checkout"
	case *p.AvailableStock == 0:
		return "Currently out of stock"
	default:
		return itoa(*p.AvailableStock) + " available"
	}
}

func description(p backend.Product) string {
	if p.Description == "" {
		return "Product details have not been provided by the store."
	}
	return p.Description
}

func priceDiff(diff float64) (string, string) {
	switch {
	case diff > 0:
		return "₹" + shop.Money(diff) + " more", "text-danger"
	case diff < 0:
		return "₹" + shop.Money(-diff) + " less", "text-strong"
	default:
		return "Same price", "text-muted"
	}
}

func jsLit(v any) string {
	b, _ := json.Marshal(v)
	return string(b)
}
