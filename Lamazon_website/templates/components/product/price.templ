package product

// price.templ — the details price row: the total for the chosen quantity at
// 28px, the struck MRP and the peach DiscountBadge beside it, and "You save"
// under it. Server text is the quantity-one render; Alpine takes over.

import (
	"lamazon/website/backend"
	"lamazon/website/shop"
)

templ Price(p backend.Product) {
	<div class="flex flex-wrap items-center gap-x-3 gap-y-2 min-[900px]:mt-5">
		<span class="product-detail-price basis-full text-text min-[900px]:basis-auto" x-text="'₹' + t('price')">₹{ shop.Money(p.Price) }</span>
		if p.AnyDiscount() {
			<span class="numeric-meta text-[14px] text-muted line-through min-[900px]:text-[16px]" x-show="discountPercent > 0" x-cloak x-text="'M.R.P. ₹' + t('mrp')">M.R.P. ₹{ shop.Money(p.MRP) }</span>
			<span class="numeric-meta rounded-badge bg-peach px-[7.7px] py-1 text-[11px] font-semibold text-text shadow-badge" x-show="discountPercent > 0" x-cloak x-text="discountPercent + '% OFF'">{ itoa(p.DiscountPercent()) }% OFF</span>
		}
	</div>
	if p.AnyDiscount() {
		<p class="mt-2 text-body font-semibold text-strong" x-show="discountPercent > 0" x-cloak x-text="'You save ₹' + t('save')">You save ₹{ shop.Money(p.MRP - p.Price) }</p>
	}
}

// DiscountBadge is the app's DiscountBadge: peach, 9px radius, "N% OFF".
templ DiscountBadge(percent int) {
	<span class="rounded-badge bg-peach px-[7.7px] py-1 text-[11px] font-extrabold tracking-[0.3px] text-text shadow-badge">{ itoa(percent) }% OFF</span>
}
