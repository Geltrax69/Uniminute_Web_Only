package product

// gallery.templ — Product photos on an uninterrupted surface, paged by
// swiping or by the controls below. On phones, compact navigation and title
// precede the image; desktop actions float over the image.

import (
	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/ui"
)

// MobileHeader keeps navigation and a compact, expandable title above the photo.
templ MobileHeader(p backend.Product, wishlisted bool) {
	<div class="min-[900px]:hidden">
		<nav aria-label="Product actions" class="flex items-center justify-between px-3 py-2">
			@ui.TactileButton("arrow-left", "Back", 44, "", templ.Attributes{"x-on:click": "history.length > 1 ? history.back() : location.assign('/')"})
			<div class="flex gap-2">
				@heroHeart(p.ID, wishlisted)
				@ui.TactileButton("shopping-cart", "Open cart", 44, "", templ.Attributes{"href": "/cart"})
			</div>
		</nav>
		<div class="px-5 pb-3 pt-1" x-data="{ expanded: false, truncated: false, measure() { if (!this.expanded) this.truncated = this.$refs.name.scrollHeight > this.$refs.name.clientHeight + 1; } }" x-init="$nextTick(() => measure())" x-on:resize.window.debounce.150ms="measure()">
			<h1 id="mobile-product-name" x-ref="name" class="text-[16px] font-medium leading-6 text-text" x-bind:class="!expanded && 'line-clamp-3'">{ p.Name }</h1>
			<button type="button" x-show="truncated" x-cloak x-on:click="expanded = !expanded" x-bind:aria-expanded="expanded" aria-controls="mobile-product-name" class="-ml-2 inline-flex min-h-touch items-center rounded-full px-2 text-[13px] font-semibold text-strong underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-strong" x-text="expanded ? 'Show less' : 'Read full title'">Read full title</button>
		</div>
	</div>
}

templ Gallery(p backend.Product, wishlisted bool) {
	{{ photos := Photos(p) }}
	<div class="relative bg-surface" x-data={ "hero(" + itoa(len(photos)) + ")" }>
		<div x-ref="track" x-on:scroll.debounce.60ms="onScroll()" class="flex h-[min(100vw,480px)] snap-x snap-mandatory overflow-x-auto overflow-y-hidden no-scrollbar min-[900px]:h-[540px] min-[900px]:rounded-small">
			for i, src := range photos {
				<div class="h-full w-full shrink-0 snap-center">
					if src == "" {
						<span class="flex h-full w-full items-center justify-center bg-img-ground">
							@ui.Icon("image-off", "h-6 w-6 text-muted")
						</span>
					} else {
						<img
							src={ templ.URL(shop.Hero(src)) }
							alt={ p.Name + ", image " + itoa(i+1) + " of " + itoa(len(photos)) }
							loading={ loadingAttr(i) }
							class="h-full w-full object-contain"/>
					}
				</div>
			}
		</div>
		<div class="absolute inset-x-0 top-0 hidden justify-between px-3.5 pt-2 min-[900px]:flex">
			@ui.TactileButton("arrow-left", "Back", 44, "", templ.Attributes{
				"x-on:click": "history.length > 1 ? history.back() : location.assign('/')",
			})
			<div class="flex gap-2">
				@heroHeart(p.ID, wishlisted)
				@ui.TactileButton("shopping-cart", "Open cart", 44, "", templ.Attributes{"href": "/cart"})
			</div>
		</div>
		if len(photos) > 1 {
			<div class="flex items-center justify-between px-4 py-1">
				<button type="button" aria-label="Previous image" x-on:click="go(-1)" x-bind:disabled="page === 0" disabled class="flex h-11 w-11 items-center justify-center rounded-full text-strong disabled:opacity-30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-strong">
					@ui.Icon("chevron-left", "h-5 w-5")
				</button>
				<div class="flex min-w-0 items-center overflow-x-auto" aria-label="Product images">
					for i := range photos {
						<button type="button" aria-label={ "Show image " + itoa(i+1) } x-bind:aria-pressed={ "page === " + itoa(i) } x-on:click={ "go(" + itoa(i) + " - page)" } class="flex h-11 w-6 shrink-0 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-strong">
							<span class="h-1.5 w-1.5 rounded-full" x-bind:class={ "page === " + itoa(i) + " ? 'bg-strong' : 'bg-track'" }></span>
						</button>
					}
				</div>
				<button type="button" aria-label="Next image" x-on:click="go(1)" x-bind:disabled="page === count - 1" class="flex h-11 w-11 items-center justify-center rounded-full text-strong disabled:opacity-30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-strong">
					@ui.Icon("chevron-right", "h-5 w-5")
				</button>
			</div>
		}
	</div>
}

// heroHeart is the save control over the photo. The app swaps heart for
// heart-handshake once saved; the state flips when the toggle succeeds.
templ heroHeart(id string, saved bool) {
	<button
		type="button"
		class="tactile inline-flex shrink-0 items-center justify-center rounded-full text-strong shadow-tactile"
		style={ templ.SafeCSS(ui.TactileStyle(44, "")) }
		hx-post="/wishlist/toggle"
		hx-vals={ templ.JSONString(map[string]string{"id": id}) }
		hx-swap="none"
		x-data={ "{ on: " + tplWhen(saved, "true", "false") + " }" }
		x-on:htmx:after-request="if ($event.detail.successful) on = !on"
		x-bind:aria-pressed="on"
		aria-label="Save product"
		title="Save product">
		if saved {
			<span class="flex" x-show="on">
				@ui.Icon("heart-handshake", "h-5 w-5")
			</span>
			<span class="flex" x-show="!on" x-cloak>
				@ui.Icon("heart", "h-5 w-5")
			</span>
		} else {
			<span class="flex" x-show="on" x-cloak>
				@ui.Icon("heart-handshake", "h-5 w-5")
			</span>
			<span class="flex" x-show="!on">
				@ui.Icon("heart", "h-5 w-5")
			</span>
		}
	</button>
}

// Photos is [imageUrl, ...extraImages]: the main picture first, then every
// other one once.
func Photos(p backend.Product) []string {
	out := []string{p.ImageURL}
	for _, u := range p.ImageURLs {
		if u != "" && u != p.ImageURL {
			out = append(out, u)
		}
	}
	return out
}

func loadingAttr(i int) string {
	if i == 0 {
		return "eager"
	}
	return "lazy"
}
