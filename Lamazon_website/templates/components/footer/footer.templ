package footer

// footer.templ — the housekeeping the app keeps in Settings/Help: who delivers,
// where, the documents, and the way out. Muted and track-divided, the way the
// app's Settings screen reads.

import "lamazon/website/templates/components/ui"

templ Footer(eta string, cities []string) {
	<footer class="mt-12 border-t border-track bg-surface px-gutter py-10 pb-36">
		<div class="mx-auto grid max-w-readable gap-8 md:grid-cols-3">
			<div>
				<h3 class="text-title-small">Lamazon</h3>
				<p class="mt-2 text-body text-muted">Local shops, delivered on campus. Real stock, real prices, cash on delivery.</p>
				<p class="mt-3 inline-flex items-center gap-2 text-small text-muted">
					@ui.Icon("truck", "h-4 w-4 text-strong")
					if eta != "" {
						<span>Delivery in about { eta }</span>
					} else {
						<span>Fast campus delivery</span>
					}
				</p>
			</div>
			<div>
				<h3 class="text-title-small">Shop</h3>
				<ul class="mt-2 space-y-1">
					<li><a class="flex min-h-touch items-center text-body text-muted hover:text-strong" href="/shop">All departments</a></li>
					<li><a class="flex min-h-touch items-center text-body text-muted hover:text-strong" href="/stores">Stores</a></li>
					<li><a class="flex min-h-touch items-center text-body text-muted hover:text-strong" href="/search">Search</a></li>
					<li><a class="flex min-h-touch items-center text-body text-muted hover:text-strong" href="/orders">Your orders</a></li>
				</ul>
			</div>
			<div>
				<h3 class="text-title-small">The fine print</h3>
				<ul class="mt-2 space-y-1">
					<li><a class="flex min-h-touch items-center text-body text-muted hover:text-strong" href="/policies">Policies</a></li>
				</ul>
				if len(cities) > 0 {
					<p class="mt-3 text-small text-muted">Delivering in { joinCities(cities) }.</p>
				}
			</div>
		</div>
	</footer>
}

func joinCities(cities []string) string {
	out := ""
	for i, c := range cities {
		if i > 0 {
			if i == len(cities)-1 {
				out += " and "
			} else {
				out += ", "
			}
		}
		out += c
	}
	return out
}
