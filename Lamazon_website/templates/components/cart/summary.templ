package cart

// summary.templ — CartScreen's right-hand column: _DeliveryAddress, the cash
// payment choice, and the one button that names the real next step.

import (
	"math"
	"strconv"

	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/ui"
)

templ DeliveryAddress(a *backend.Address) {
	<div class="rounded bg-surface p-4 shadow-surface">
		<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
			@ui.Icon("map-pin", "h-5 w-5 text-text")
			<span class="w-2"></span>
			<span class="text-[16px] font-bold text-text">Deliver to</span>
			<a href={ templ.SafeURL(tplWhen(a == nil, "/addresses/new", "/addresses")) } class="inline-flex min-h-touch items-center rounded-full px-3 text-label text-strong hover:bg-strong/[.06]">
				{ tplWhen(a == nil, "Add address", "Change") }
			</a>
		</div>
		if a != nil {
			<p class="text-body font-semibold text-text">{ a.Name }</p>
			<p class="mt-1 text-body text-muted">{ a.Line }, { a.City } { a.Pincode }</p>
			if a.Phone != "" {
				<p class="text-body text-muted">{ a.Phone }</p>
			}
		} else {
			<p class="text-body text-muted">Choose a delivery address before placing your order.</p>
		}
	</div>
}

templ Summary(d Data) {
	{{ sub := shop.CartSubtotal(d.Entries) }}
	{{ total := sub + shop.ChargesTotal(d.Charges) }}
	<div class="rounded bg-surface px-5 py-[18px] shadow-surface">
		<h2 class="text-section text-text">Order Summary</h2>
		<div class="h-3"></div>
		@summaryRow(subtotalLabel(d.Count()), sub, false)
		for _, c := range d.Charges {
			<div class="h-1"></div>
			@summaryRow(c.Name, c.Amount, false)
			if c.ID == "delivery" {
				<p class="mt-0.5 flex items-center text-body text-muted">
					@ui.Icon("clock", "h-[13px] w-[13px] shrink-0")
					<span class="ml-1.5">Arrives in about { shop.DeliveryETA }</span>
				</p>
			}
		}
		<div class="my-2.5 h-px"></div>
		@summaryRow("Total", total, true)
		<div class="h-3.5"></div>
		{{ short := shop.CartShortfall(d.Entries) }}
		if d.SignedIn {
			<div x-data={ "razorpayCheckout(" + strconv.FormatInt(paymentPaise(total), 10) + ")" }>
				<fieldset>
					<legend class="mb-2.5 text-[14px] font-bold text-text">Payment method</legend>
					<div class="grid grid-cols-2 gap-2" role="radiogroup">
						<label
							class="relative flex min-h-[72px] cursor-pointer items-center rounded-[12px] px-3 py-2.5 outline-none transition focus-within:ring-2 focus-within:ring-strong focus-within:ring-offset-2"
							x-bind:class="method === 'razorpay' ? 'bg-strong text-white shadow-control' : 'bg-base text-text hover:bg-track/60'">
							<input class="sr-only" type="radio" name="paymentMethod" value="razorpay" x-model="method" x-on:change="error = ''" x-bind:disabled="!!pendingPayment" checked/>
							@ui.Icon("shield-check", "h-5 w-5 shrink-0")
							<span class="ml-2.5 min-w-0">
								<span class="block text-[14px] font-bold leading-tight">Razorpay</span>
								<span class="mt-1 block text-[12px] leading-tight" x-bind:class="method === 'razorpay' ? 'text-white/75' : 'text-muted'">Pay online</span>
							</span>
							<span class="ml-auto flex h-4 w-4 shrink-0 items-center justify-center rounded-full border" x-bind:class="method === 'razorpay' ? 'border-white bg-white' : 'border-muted/50'">
								<span class="h-2 w-2 rounded-full bg-strong" x-show="method === 'razorpay'"></span>
							</span>
						</label>
						<label
							class="relative flex min-h-[72px] cursor-pointer items-center rounded-[12px] px-3 py-2.5 outline-none transition focus-within:ring-2 focus-within:ring-strong focus-within:ring-offset-2"
							x-bind:class="method === 'cod' ? 'bg-strong text-white shadow-control' : 'bg-base text-text hover:bg-track/60'">
							<input class="sr-only" type="radio" name="paymentMethod" value="cod" x-model="method" x-on:change="error = ''" x-bind:disabled="!!pendingPayment"/>
							@ui.Icon("banknote", "h-5 w-5 shrink-0")
							<span class="ml-2.5 min-w-0">
								<span class="block text-[14px] font-bold leading-tight">Cash on Delivery</span>
								<span class="mt-1 block text-[12px] leading-tight" x-bind:class="method === 'cod' ? 'text-white/75' : 'text-muted'">Pay on arrival</span>
							</span>
							<span class="ml-auto flex h-4 w-4 shrink-0 items-center justify-center rounded-full border" x-bind:class="method === 'cod' ? 'border-white bg-white' : 'border-muted/50'">
								<span class="h-2 w-2 rounded-full bg-strong" x-show="method === 'cod'" x-cloak></span>
							</span>
						</label>
					</div>
				</fieldset>
				<form
					x-ref="cashForm"
					method="post"
					action="/checkout"
					class="hidden"
					x-on:submit="cashBusy = true; lwProcessing('Placing your order…', false)"
				>
					if d.Address != nil {
						<input type="hidden" name="addressId" value={ d.Address.ID }/>
					}
				</form>
				<button
					type="button"
					class={ ui.ButtonClass(true) + " mt-3.5 w-full" }
					x-on:click="place($refs.cashForm)"
					x-bind:disabled={ tplWhen(short > 0 || d.Address == nil, "true", "busy || cashBusy") }
					disabled?={ short > 0 || d.Address == nil }
					x-bind:aria-busy="busy || cashBusy">
					<span class="h-[15px] w-[15px] shrink-0 animate-spin rounded-full border-2 border-white border-t-transparent" x-show="busy" x-cloak></span>
					<span class="h-[15px] w-[15px] shrink-0 animate-spin rounded-full border-2 border-white border-t-transparent" x-show="cashBusy" x-cloak></span>
					<span x-show="!busy && !cashBusy && method === 'razorpay'">@ui.Icon("shield-check", "h-[17px] w-[17px]")</span>
					<span x-show="!busy && !cashBusy && method === 'cod'" x-cloak>@ui.Icon("banknote", "h-[17px] w-[17px]")</span>
					<span class="truncate whitespace-pre" x-show="!busy && !cashBusy" x-text="buttonLabel">Continue with Razorpay  ·  ₹{ shop.Money(total) }</span>
					<span class="truncate" x-show="busy" x-cloak>Opening secure checkout…</span>
					<span class="truncate" x-show="cashBusy" x-cloak>Placing your order…</span>
				</button>
				<p class="mt-2 text-body text-danger" role="alert" x-show="error" x-text="error" x-cloak></p>
				if short > 0 {
					@ui.Unavailable(tplWhen(short == 1, "1 item is short on stock. Lower its quantity or remove it to place your order.", shop.Itoa(short)+" items are short on stock. Lower their quantity or remove them to place your order."))
				}
			</div>
		} else {
			<a href="/login?next=/cart" class={ ui.ButtonClass(true) + " w-full" }>
				<span class="truncate">Sign in to place order</span>
			</a>
		}
	</div>
}

templ summaryRow(label string, value float64, bold bool) {
	<div class={ "flex items-center justify-between " + tplWhen(bold, "text-[15px] font-semibold text-text", "text-[13px] font-medium text-muted") }>
		<span class="min-w-0 flex-1">{ label }</span>
		<span class={ "ml-3 text-right " + tplWhen(bold, "display-price text-[27px]", "numeric-meta text-[14px]") }>₹{ shop.Money(value) }</span>
	</div>
}

func subtotalLabel(n int) string {
	if n == 1 {
		return "Sub Total (1 item)"
	}
	return "Sub Total (" + shop.Itoa(n) + " items)"
}

func paymentPaise(v float64) int64 {
	return int64(math.Round(v * 100))
}
