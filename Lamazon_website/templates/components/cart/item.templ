package cart

// item.templ — _CartRow from cart_screen.dart: a raised card with the 88px
// photo, store, name, struck MRP and badge, the line total; under a divider,
// the unit price and _QtyControls. At one unit the minus becomes a red bin,
// because going below one removes the line.

import (
	"strconv"

	"lamazon/website/shop"
	"lamazon/website/templates/components/product"
	"lamazon/website/templates/components/ui"
)

templ Item(e shop.CartEntry) {
	{{ p := e.Product }}
	{{ limit, capped := e.Cap() }}
	{{ atCap := capped && e.Qty >= limit }}
	{{ last := e.Qty <= 1 }}
	<article class="rounded bg-surface p-3.5 shadow-surface">
		<div class="flex items-start">
			<a href={ templ.SafeURL("/p/" + p.ID) } class="h-[88px] w-[88px] shrink-0 overflow-hidden rounded-small" tabindex="-1" aria-hidden="true">
				if p.ImageURL != "" {
					<img src={ templ.URL(shop.CatalogueImage(p.ImageURL, 160)) } alt="" loading="lazy" class="h-full w-full object-cover"/>
				} else {
					<span class="flex h-full w-full items-center justify-center bg-img-ground">
						@ui.Icon("image-off", "h-6 w-6 text-muted")
					</span>
				}
			</a>
			<div class="ml-3.5 min-w-0 flex-1">
				<p class="text-[12px] text-muted">{ p.Store }</p>
				<a href={ templ.SafeURL("/p/" + p.ID) } class="mt-1 line-clamp-3 text-[16px] font-semibold text-text">{ p.Name }</a>
				<div class="h-2"></div>
				if p.Discounted() {
					<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
						<span class="text-[12px] text-muted line-through">MRP ₹{ shop.Money(p.MRP * float64(e.Qty)) }</span>
						@product.DiscountBadge(p.DiscountPercent())
					</div>
				}
				<p class="text-[18px] font-extrabold text-text">₹{ shop.Money(e.LineTotal()) }</p>
			</div>
		</div>
		<div class="mt-3 h-px"></div>
		<div class="mt-2.5 flex items-center">
			<p class="min-w-0 flex-1 text-[12px] text-muted">₹{ shop.Money(p.Price) } each</p>
			<button
				type="button"
				class={ "tactile inline-flex shrink-0 items-center justify-center rounded-full shadow-tactile " + tplWhen(last, "text-danger", "text-strong") }
				style={ templ.SafeCSS(ui.TactileStyle(44, "")) }
				hx-post="/cart/set"
				hx-vals={ templ.JSONString(map[string]any{"id": p.ID, "qty": e.Qty - 1}) }
				hx-target="#cart-body"
				hx-swap="outerHTML"
				aria-label={ tplWhen(last, "Remove item", "Decrease quantity") }
				title={ tplWhen(last, "Remove item", "Decrease quantity") }>
				@ui.Icon(tplWhen(last, "trash-2", "minus"), "h-5 w-5")
			</button>
			<span class="px-2 text-[13px] font-bold text-text">{ strconv.Itoa(e.Qty) }</span>
			<button
				type="button"
				class="tactile inline-flex shrink-0 items-center justify-center rounded-full text-strong shadow-tactile"
				style={ templ.SafeCSS(ui.TactileStyle(44, "#C6EE63")) }
				hx-post="/cart/set"
				hx-vals={ templ.JSONString(map[string]any{"id": p.ID, "qty": e.Qty + 1}) }
				hx-target="#cart-body"
				hx-swap="outerHTML"
				disabled?={ atCap }
				aria-label={ tplWhen(atCap, "That is all the shop has", "Increase quantity") }
				title={ tplWhen(atCap, "That is all the shop has", "Increase quantity") }>
				@ui.Icon("plus", "h-5 w-5")
			</button>
		</div>
	</article>
}

func tplWhen(cond bool, a, b string) string {
	if cond {
		return a
	}
	return b
}
