package collection

// filters.templ — the filter sidebar / sheet. On desktop it is a sticky
// column; on mobile it opens as an Alpine drawer sheet from the bottom.

import (
	"lamazon/website/backend"
	"lamazon/website/tpl"
)

type FilterState struct {
	Tab      string
	Category string
	Q        string
}

templ Filters(categories []backend.Category, fs FilterState) {
	// Desktop: sticky left column (hidden below md)
	<aside class="hidden md:block w-52 shrink-0">
		@filterBody(categories, fs)
	</aside>
	// Mobile: a bottom sheet toggled by Alpine
	<div
		class="md:hidden"
		x-data="{ open: false }"
		x-on:keydown.escape.window="open = false">
		<button
			class="flex min-h-touch items-center gap-1.5 rounded-full border border-track bg-surface px-4 py-2 text-label text-text"
			x-on:click="open = true"
			x-bind:aria-expanded="open">
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="8" y1="12" x2="16" y2="12"></line><line x1="11" y1="18" x2="13" y2="18"></line></svg>
			Filter
		</button>
		<div
			class="fixed inset-0 z-[55]"
			x-show="open"
			x-cloak
			x-transition.opacity
			x-on:click.self="open = false">
			<div
				class="absolute inset-x-0 bottom-0 max-h-[80vh] overflow-y-auto rounded-t-featured bg-canvas p-4 shadow-raised"
				x-on:click.stop>
				<div class="mb-4 flex items-center justify-between">
					<h3 class="text-section">Filter</h3>
					<button class="text-muted" x-on:click="open = false" aria-label="Close filters">✕</button>
				</div>
				@filterBody(categories, fs)
				<div class="mt-4">
					<button
						class="flex min-h-button w-full items-center justify-center rounded-full bg-forest px-6 py-3 text-label text-white"
						x-on:click="open = false">
						Apply
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ filterBody(categories []backend.Category, fs FilterState) {
	<div class="space-y-4">
		if len(categories) > 0 {
			<div>
				<p class="mb-2 text-label">Category</p>
				<ul class="space-y-0.5">
					<li>
						<a
							href={ templ.URL(filterURL(fs, "")) }
							class={ "flex min-h-touch items-center rounded-small px-3 text-body " + tpl.When(fs.Category == "", "bg-lime/50 font-semibold", "hover:bg-strong/5") }>
							All
						</a>
					</li>
					for _, c := range categories {
						<li>
							<a
								href={ templ.URL(filterURL(fs, c.Name)) }
								class={ "flex min-h-touch items-center rounded-small px-3 text-body " + tpl.When(fs.Category == c.Name, "bg-lime/50 font-semibold", "hover:bg-strong/5") }>
								{ c.Name }
							</a>
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

func filterURL(fs FilterState, category string) string {
	base := "/shop"
	sep := "?"
	if fs.Tab != "" {
		base += sep + "tab=" + fs.Tab
		sep = "&"
	}
	if fs.Q != "" {
		base += sep + "q=" + fs.Q
		sep = "&"
	}
	if category != "" {
		base += sep + "category=" + category
	}
	return base
}
