package pages

// checkout.templ — OrderConfirmationScreen, where placing an order lands: the
// lime tick, the amount to hand the rider, where it is going and when, one
// card per order (a basket spanning shops becomes several), and the way back.

import (
	"net/url"
	"strings"

	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/ui"
	"lamazon/website/templates/layouts"
	"lamazon/website/viewdata"
)

type PlacedPageData struct {
	Page   viewdata.Page
	Orders []backend.Order
}

templ OrderPlaced(d PlacedPageData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", withTopBar(d.Page, placedBody(d)))
}

templ placedBody(d PlacedPageData) {
	<main id="main" class="mx-auto w-full max-w-readable p-6">
		<div class="h-9"></div>
		<div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-lime text-strong shadow-tactile">
			@ui.Icon("check", "h-9 w-9")
		</div>
		<h1 class="mt-6 text-center text-title text-text">Your order is placed</h1>
		<p class="mt-3 text-center text-body leading-[1.5] text-muted">Order placed successfully. This page updates automatically when the store or rider moves it forward.</p>
		<div x-data="notifyPermission()" class="mt-5 rounded bg-surface p-4 shadow-surface">
			<div class="flex items-start gap-3">
				<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime/40 text-strong">
					@ui.Icon("bell", "h-5 w-5")
				</span>
				<div class="min-w-0 flex-1">
					<p class="text-body font-semibold text-text">Get live order updates</p>
					<p class="mt-1 text-body text-muted">We send order updates by email. Connect this device for store acceptance, rider pickup, and delivery notifications.</p>
					<button type="button" x-show="state !== 'granted' && state !== 'unsupported'" x-on:click="ask()" x-bind:disabled="busy" class="mt-3 min-h-touch rounded-full bg-strong px-4 text-label text-white disabled:opacity-60">
						<span x-text="busy ? 'Connecting…' : 'Turn on push notifications'"></span>
					</button>
					<p x-show="state === 'granted' && !error" class="mt-2 text-body font-semibold text-strong">Push notifications are connected.</p>
					<p x-show="error" x-text="error" class="mt-2 text-body text-danger" role="alert"></p>
				</div>
			</div>
		</div>
		<div class="mt-7 rounded bg-surface p-5 shadow-surface">
			<p class="text-body text-muted">Pay on delivery</p>
			<p class="display-price text-[30px] text-text">₹{ shop.Money(ordersTotal(d.Orders)) }</p>
			<div class="h-3"></div>
			if len(d.Orders) > 0 {
				<p class="text-body text-text">{ d.Orders[0].ReceiverAddress }</p>
			}
			<p class="mt-2 flex items-center text-body font-semibold text-strong">
				@ui.Icon("clock", "h-[15px] w-[15px] shrink-0")
				<span class="ml-1.5">Arriving in about { shop.DeliveryETA }</span>
			</p>
		</div>
		<div class="h-4"></div>
		<div
			id="placed-orders-live"
			hx-get={ templ.SafeURL(placedRefreshURL(d.Orders)) }
			hx-trigger={ placedPollTrigger(d.Orders) }
			hx-select="#placed-orders-live"
			hx-target="this"
			hx-swap="outerHTML">
			for _, o := range d.Orders {
				<div class="mb-3 rounded bg-surface p-4 shadow-surface">
				<p class="select-all text-body font-bold text-text">Order { shop.OrderRef(o.ID) }</p>
				<p class="mt-1 text-body text-text">{ shop.Itoa(o.Units) } × { o.ItemTitle }</p>
				if len(o.Options) > 0 {
					<p class="mt-0.5 text-[12.5px] font-medium text-strong">{ shop.ChoicesText(o.Options) }</p>
				}
				<p class="text-body text-muted">{ o.StoreName }</p>
				<div class="mt-4 rounded bg-canvas p-3">
					<p class="mb-3 text-body font-semibold text-strong" aria-live="polite">{ statusLabel(o) }</p>
					@statusTrack(o)
					if o.DeliveryCode != "" && o.Stage != backend.StageDelivered {
						<p class="mt-3 text-center text-body text-muted">Delivery code</p>
						<p class="mt-0.5 select-all text-center text-[24px] font-extrabold tracking-[6px] text-strong">{ o.DeliveryCode }</p>
					}
				</div>
				<div class="my-3 h-px"></div>
				<a href={ templ.SafeURL("/orders/" + o.ID) } class={ ui.ButtonClass(false) }>
					<span class="truncate">Track order</span>
					@ui.Icon("package", "h-[18px] w-[18px]")
				</a>
				</div>
			}
		</div>
		<div class="h-6"></div>
		<a href="/" class={ ui.ButtonClass(true) + " w-full" }>
			<span class="truncate">Continue shopping</span>
		</a>
	</main>
}

func ordersTotal(orders []backend.Order) float64 {
	sum := 0.0
	for _, o := range orders {
		sum += o.Amount
	}
	return sum
}

func placedRefreshURL(orders []backend.Order) string {
	ids := make([]string, 0, len(orders))
	for _, o := range orders {
		ids = append(ids, o.ID)
	}
	return "/orders/placed?ids=" + url.QueryEscape(strings.Join(ids, ","))
}

func placedPollTrigger(orders []backend.Order) string {
	for _, o := range orders {
		if o.Stage != backend.StageDelivered && o.Stage != backend.StageRejected {
			return "every 5s [document.visibilityState === 'visible']"
		}
	}
	return ""
}
