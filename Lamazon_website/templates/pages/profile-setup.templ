package pages

import (
 "lamazon/website/templates/components/ui"
 "lamazon/website/templates/layouts"
 "lamazon/website/viewdata"
)

type ProfileSetupData struct { Page viewdata.Page; Next string; City string }

templ ProfileSetup(d ProfileSetupData) {
 @layouts.Base(d.Page.Title, d.Page.Description, "", withTopBar(d.Page, profileSetupBody(d)))
}

// The live card stays in place while its owner's details arrive, one step at a time.
templ profileSetupBody(d ProfileSetupData) {
 <main id="main" class="setup-shell" x-bind:class="{ 'is-avatar-step': step === 0 }" x-data={ profileSetupState(d) }>
  <header class="setup-heading">
   <a href="/?browse=1" class="setup-brand" aria-label="Uniminute home"><img src="/static/images/logo.png" alt="" width="28" height="28"/>Uniminute</a>
   <span class="setup-heading-note">A little about you.</span>
  </header>
  <div class="setup-progress-label"><span x-text="complete ? 'Ready to go' : 'Step ' + (step + 1) + ' of 5'">Step 1 of 5</span><span x-text="progress + '%'">20%</span></div>
  <div class="setup-progress" role="progressbar" aria-label="Profile setup" aria-valuemin="0" aria-valuemax="100" x-bind:aria-valuenow="progress" x-bind:aria-valuetext="complete ? 'Profile saved' : stepLabel">
   <span x-bind:style="'transform: scaleX(' + progress / 100 + ')'" style="transform:scaleX(.2)"></span>
  </div>
  <div class="setup-layout" x-show="!complete">
   <section class="setup-preview" aria-label="Your profile card preview">
    <p class="setup-card-caption">YOUR UNIMINUTE CARD</p>
    <div class="profile-card-stage">
     <div class="profile-card" x-bind:class="{ 'is-flipped': step === 3 }">
      <div class="profile-card-face profile-card-front" x-bind:aria-hidden="step === 3">
       <div class="profile-card-top"><span>Uniminute</span>@ui.Icon("sparkles", "h-5 w-5")</div>
       <div class="profile-card-person">
        <div class="profile-card-details">
         <p class="profile-card-name" x-text="name.trim() || 'Your name, right here.'">Your name, right here.</p>
         <p class="profile-card-email">{ profileSetupEmail(d) }</p>
         <p class="profile-card-phone" x-show="phone.trim()" x-text="displayPhone" x-cloak></p>
        </div>
        <img class="profile-card-avatar" x-bind:src="avatarURL" src={ profileAvatarURL(profileSetupAvatar(d)) } alt="Your selected avatar" width="112" height="112"/>
       </div>
       <div class="profile-card-footer">
        <span class="profile-card-interest" x-text="interestLabel">Everyday shopper</span>
        <span class="profile-card-address" x-text="line.trim() || 'Your neighbourhood. Your favourites.'">Your neighbourhood. Your favourites.</span>
       </div>
      </div>
      <div class="profile-card-face profile-card-back" x-bind:aria-hidden="step !== 3">
       <div class="profile-card-top"><span>Just between us.</span>@ui.Icon("lock", "h-5 w-5")</div>
       <div class="profile-card-secret" aria-hidden="true">•••• &nbsp;••••</div>
       <p>Your password never appears on your card.</p>
       <span class="profile-card-back-mark">Uniminute</span>
      </div>
     </div>
    </div>
    <p class="setup-preview-note" x-text="step === 3 ? 'A private space for your password.' : 'A little more you, with every step.'">A little more you, with every step.</p>
   </section>
   <form class="setup-form" x-on:submit.prevent="advance()" x-on:input="error = ''; if (!saving) saveKey = ''" x-bind:aria-busy="saving" novalidate>
    <div class="setup-step-copy" aria-live="polite">
     <h1 x-ref="stepTitle" tabindex="-1" x-text="title">Make it yours.</h1>
     <p x-text="description">Pick a world you love. Then choose a face for your card.</p>
    </div>
    <div x-show="step === 0" class="setup-step">
     <div class="setup-interests" role="group" aria-label="Choose your interest">
      for _, group := range profileInterests {
       <button type="button" class="setup-interest" x-bind:aria-pressed={ "interest === " + jsonArg(group.ID) } x-on:click={ "chooseInterest(" + jsonArg(group.ID) + ")" }>{ group.Label }</button>
      }
     </div>
     <div class="setup-avatar-heading"><span>Choose your avatar</span><span x-text="options.length === 1 ? 'This one’s you?' : options.length + ' to choose from'"></span></div>
     <div class="setup-avatar-options" role="group" aria-label="Choose your avatar">
      <template x-for="option in options" x-bind:key="option.id">
       <button type="button" class="setup-avatar-option" x-on:click="avatar = option.id; saveKey = ''" x-bind:aria-pressed="avatar === option.id" x-bind:aria-label="'Choose ' + option.label + ' avatar'">
        <img x-bind:src="'/static/images/avatars/' + option.id + '.png'" x-bind:alt="option.label" width="100" height="100"/>
        <span class="setup-avatar-check" x-show="avatar === option.id">@ui.Icon("check", "h-3.5 w-3.5")</span>
       </button>
      </template>
     </div>
    </div>
    <div x-show="step === 1" class="setup-step" x-cloak>
     <label class="setup-field-label" for="setup-name">Full name</label>
     <input x-bind:disabled="saving" class="setup-input" id="setup-name" x-ref="nameInput" name="name" x-model="name" autocomplete="name" maxlength="100" placeholder="What should we call you?" x-bind:aria-invalid="!!error" aria-describedby="setup-error"/>
    </div>
    <div x-show="step === 2" class="setup-step" x-cloak>
     <label class="setup-field-label" for="setup-phone">Mobile number</label>
     <div class="setup-phone-input"><span>+91</span><input x-bind:disabled="saving" class="setup-input" id="setup-phone" x-ref="phoneInput" name="phone" x-bind:value="phone" x-on:input="setPhone($event.target.value); $event.target.value = phone" x-on:paste="pastePhone($event)" type="tel" inputmode="numeric" autocomplete="tel-national" minlength="10" maxlength="10" pattern="[6-9][0-9]{9}" placeholder="Your 10-digit mobile number" x-bind:aria-invalid="!!error" aria-describedby="setup-error"/></div>
     <p class="setup-field-hint">Enter 10 digits. +91 is added automatically for delivery updates and calls from your rider.</p>
    </div>
    <div x-show="step === 3" class="setup-step" x-cloak>
     <div x-show="!hasPassword">
      <label class="setup-field-label" for="setup-password">Password <span>Optional</span></label>
      <div class="setup-password-input"><input x-bind:disabled="saving" class="setup-input" id="setup-password" x-ref="passwordInput" name="password" x-model="password" x-bind:type="revealPassword ? 'text' : 'password'" type="password" autocomplete="new-password" minlength="8" maxlength="200" placeholder="At least 8 characters" aria-describedby="setup-error"/><button class="setup-reveal" type="button" x-on:click="revealPassword = !revealPassword" x-bind:aria-label="revealPassword ? 'Hide password' : 'Show password'">@ui.Icon("eye", "h-5 w-5")</button></div>
      <p class="setup-field-hint">Or skip this. You can always sign in with an email code.</p>
     </div>
     <p class="setup-field-hint" x-show="hasPassword">You already have a password. Keep going to add your address.</p>
    </div>
    <div x-show="step === 4" class="setup-step" x-cloak>
     <label class="setup-field-label" for="setup-address">Delivery address</label>
     <textarea x-bind:disabled="saving" class="setup-input setup-address-input" id="setup-address" x-ref="addressInput" name="line" x-model="line" autocomplete="street-address" maxlength="300" rows="2" placeholder="Hostel and room, or block and shop" x-bind:aria-invalid="!!error" aria-describedby="setup-error"></textarea>
     <div class="setup-address-meta"><span>@ui.Icon("map-pin", "h-4 w-4"){ d.City }</span><span>Save as</span></div>
     <div class="setup-address-labels" role="group" aria-label="Address label">
      for _, label := range []string{"Home", "Office", "Other"} {
       <button class="setup-interest" x-bind:disabled="saving" type="button" x-bind:aria-pressed={ "label === " + jsonArg(label) } x-on:click={ "label = " + jsonArg(label) + "; saveKey = ''" }>{ label }</button>
      }
     </div>
    </div>
    <p id="setup-error" class="setup-error" role="alert" x-show="error" x-text="error" x-cloak></p>
    <p class="setup-save-note" role="status" x-show="saving" x-cloak>Saving your profile and delivery address…</p>
    <div class="setup-actions">
     <button type="button" class="setup-back" x-on:click="back()" x-bind:disabled="saving" x-show="step > 0" x-cloak>@ui.Icon("arrow-left", "h-4 w-4")<span>Back</span></button>
     <button type="submit" class="setup-next" x-bind:disabled="saving" x-bind:aria-busy="saving"><span x-show="saving" class="setup-spinner" x-cloak></span><span x-text="saving ? 'Saving…' : step === 4 ? 'Create my card' : step === 3 && !password ? 'Skip for now' : 'Continue'">Continue</span><span x-show="!saving">@ui.Icon("arrow-right", "h-4 w-4")</span></button>
    </div>
   </form>
  </div>
  <section class="setup-success" x-show="complete" x-cloak aria-labelledby="setup-success-title">
   <div class="setup-success-avatar"><img x-bind:src="avatarURL" src={ profileAvatarURL(profileSetupAvatar(d)) } alt="Your saved avatar" width="112" height="112"/><span>@ui.Icon("check", "h-5 w-5")</span></div>
   <p class="setup-success-percent">100% YOU.</p>
   <h1 id="setup-success-title" x-ref="successTitle" tabindex="-1">Your card is ready.</h1>
   <p>Your profile is saved. Your neighbourhood is waiting.</p>
   <a class="setup-next" href={ templ.URL(d.Next) } x-bind:href="next">
    <span>Start shopping</span>
    @ui.Icon("arrow-right", "h-4 w-4")
   </a>
  </section>
  <noscript><p>Enable JavaScript to complete your profile, or return to <a href="/">the shop</a>.</p></noscript>
 </main>
}

func profileSetupEmail(d ProfileSetupData)string{if d.Page.User!=nil{return d.Page.User.Email};return ""}
func profileSetupAvatar(d ProfileSetupData)string{if d.Page.User!=nil && d.Page.User.Avatar!=""{return d.Page.User.Avatar};return "everyday-shopper"}
func profileSetupState(d ProfileSetupData)string{
 name,phone,avatar,interest,line,label,hasPassword:="","","everyday-shopper","everyday","","Home",false
 if d.Page.User!=nil{name,phone,hasPassword=d.Page.User.Name,d.Page.User.Phone,d.Page.User.HasPassword;if d.Page.User.Avatar!=""{avatar=d.Page.User.Avatar};if d.Page.User.Interest!=""{interest=d.Page.User.Interest}}
 if d.Page.Address!=nil{line,label=d.Page.Address.Line,d.Page.Address.Label}
 return "profileSetup("+jsonArg(map[string]any{"name":name,"phone":phone,"avatar":avatar,"interest":interest,"line":line,"label":label,"hasPassword":hasPassword,"city":d.City,"next":d.Next,"groups":profileInterests})+")"
}
