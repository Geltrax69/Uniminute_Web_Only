package pages

// profile-setup.templ — ProfileSetupScreen, asked once right after a first
// sign-in: name, mobile, an optional password, and the one address an order
// needs. The city is shown, not asked: there is one campus to deliver to.

import (
	"lamazon/website/templates/components/account"
	"lamazon/website/templates/components/navigation"
	"lamazon/website/templates/components/ui"
	"lamazon/website/templates/layouts"
	"lamazon/website/viewdata"
)

type ProfileSetupData struct {
	Page viewdata.Page
	Next string
	City string
}

templ ProfileSetup(d ProfileSetupData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", withTopBar(d.Page, profileSetupBody(d)))
}

templ profileSetupBody(d ProfileSetupData) {
	<main id="main" class="mx-auto w-full max-w-[560px]">
		<form
			class="flex min-h-[100dvh] flex-col"
			hx-post="/profile/setup"
			hx-swap="none"
			x-data={ profileSetupState(d) }
			x-on:htmx:before-request="saving = true"
			x-on:htmx:after-request="saving = false">
			@navigation.ScreenHeader("Your details")
			<input type="hidden" name="next" value={ d.Next }/>
			<input type="hidden" name="city" value={ d.City }/>
			<input type="hidden" name="label" x-bind:value="label"/>
			<div class="flex-1 px-5 pb-6 pt-1">
				<p class="text-[13.5px] text-muted">We ask once, so an order knows who it is for and where it is going.</p>
				<div class="h-[22px]"></div>
				@account.Section("Name", "")
				@account.Field("name", "Full name", "user", "text", "name")
				<div class="h-[22px]"></div>
				@account.Section("Mobile number", "")
				@account.Field("phone", "So the rider can call you", "phone", "tel", "tel")
				<div class="h-[22px]"></div>
				@account.Section("Password", "Optional — set one to skip the emailed code")
				@account.Field("password", "At least 8 characters", "lock", "password", "new-password")
				<div class="h-[22px]"></div>
				@account.Section("Address", "Hostel and room, or block and shop")
				@account.Field("line", "e.g. Hostel BH-9, Room 214", "house", "text", "street-address")
				<div class="h-[22px]"></div>
				@account.Section("Save as", "")
				<div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Save as">
					@account.Choice("Home", "home", "label")
					@account.Choice("Office", "office", "label")
					@account.Choice("Other", "other", "label")
				</div>
				<div class="h-[22px]"></div>
				@account.Section("Where we deliver", "")
				<div class="flex items-center rounded bg-white px-4 py-3.5">
					@ui.Icon("circle-check-big", "h-4 w-4 shrink-0 text-[#1B7F3B]")
					<p class="ml-2.5 flex-1 text-[14px] font-bold text-text">{ d.City }</p>
				</div>
			</div>
			@account.SubmitBar("Save and continue", "Saving…")
		</form>
	</main>
}

func profileSetupState(d ProfileSetupData) string {
	name, phone := "", ""
	if d.Page.User != nil {
		name, phone = d.Page.User.Name, d.Page.User.Phone
	}
	return "{ name: " + jsonArg(name) + ", phone: " + jsonArg(phone) + ", password: '', line: '', label: 'home', saving: false," +
		" get blocker() {" +
		" if (!this.name.trim()) return 'Add your name';" +
		" if (this.phone.trim().length < 7) return 'Add a mobile number';" +
		" if (this.password && this.password.length < 8) return 'A password needs at least 8 characters';" +
		" if (!this.line.trim()) return 'Add where we deliver to you';" +
		" return null } }"
}
