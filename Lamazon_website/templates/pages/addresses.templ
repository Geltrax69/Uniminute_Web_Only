package pages

// addresses.templ — AddressesScreen and LocationScreen. The list: one white
// card per address, the delivering one outlined in ink with its chip, tap to
// deliver there, edit and delete beside it, "Add new address" pinned below.
// The form: name, mobile, hostel/room, Save as (Home / Office / Other), the
// serviceability banner, the cities we deliver to, and one Save button that
// only wakes for a complete address.

import (
	"strings"

	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/navigation"
	"lamazon/website/templates/components/ui"
	"lamazon/website/templates/layouts"
	"lamazon/website/tpl"
	"lamazon/website/viewdata"
)

type AddressesPageData struct {
	Page      viewdata.Page
	Addresses []backend.Address
}

templ AddressesPage(d AddressesPageData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", withTopBar(d.Page, addressesBody(d)))
}

templ addressesBody(d AddressesPageData) {
	<main id="main" class="mx-auto flex min-h-[100dvh] w-full max-w-readable flex-col">
		@navigation.ScreenHeader("Delivery addresses")
		<div class="flex-1">
			if len(d.Addresses) == 0 {
				<div class="flex h-full min-h-[50vh] flex-col items-center justify-center">
					@ui.Icon("map-pin-off", "h-11 w-11 text-[#9E9E9E]")
					<p class="mt-3 text-[14px] text-muted">No saved addresses</p>
				</div>
			} else {
				<div class="px-5 pb-5 pt-1" role="radiogroup" aria-label="Delivery address">
					for _, a := range d.Addresses {
						<div class={ "mb-3 flex items-start rounded-featured bg-white p-3.5", templ.KV("ring-[1.5px] ring-text", a.Default) }>
							<button
								type="button"
								role="radio"
								aria-checked={ tpl.When(a.Default, "true", "false") }
								aria-label={ addressTitle(a) + ", " + addressFull(a) }
								class="flex min-w-0 flex-1 items-start text-left"
								hx-post={ "/account/addresses/" + a.ID + "/default" }
								hx-swap="none">
								<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-canvas text-text">
									@ui.Icon(addressIcon(a.Label), "h-[18px] w-[18px]")
								</span>
								<span class="ml-3 min-w-0 flex-1">
									<span class="flex items-center">
										<span class="text-[14px] font-bold text-text">{ addressTitle(a) }</span>
										if a.Default {
											<span class="ml-2 rounded-[10px] bg-text px-2 py-[3px] text-[8px] font-extrabold text-white">DELIVERING HERE</span>
										}
									</span>
									<span class="mt-[3px] block text-[12px] leading-[1.4] text-muted">{ addressSummary(a) }</span>
								</span>
							</button>
							<a href={ templ.SafeURL("/addresses/" + a.ID + "/edit") } class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-strong hover:bg-strong/[.06]" aria-label="Edit address" title="Edit address">
								@ui.Icon("pencil", "h-4 w-4")
							</a>
							<button
								type="button"
								class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-muted hover:bg-strong/[.06]"
								hx-post={ "/account/addresses/" + a.ID + "/delete" }
								hx-swap="none"
								hx-confirm={ "Delete address?\n\n" + addressFull(a) }
								data-confirm-ok="Delete"
								data-confirm-danger
								aria-label="Delete address"
								title="Delete address">
								@ui.Icon("trash-2", "h-4 w-4")
							</button>
						</div>
					}
				</div>
			}
		</div>
		<div class="sticky bottom-0 bg-canvas px-5 pb-[calc(16px+env(safe-area-inset-bottom))] pt-2">
			<a href="/addresses/new" class={ ui.ButtonClass(true) + " w-full" }>
				<span class="truncate">Add new address</span>
				@ui.Icon("plus", "h-[18px] w-[18px]")
			</a>
		</div>
	</main>
}

type AddressFormData struct {
	Page    viewdata.Page
	Address *backend.Address // nil when adding
	Cities  []string
}

templ AddressForm(d AddressFormData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", withTopBar(d.Page, addressFormBody(d)))
}

templ addressFormBody(d AddressFormData) {
	<main id="main" class="mx-auto w-full max-w-readable">
		<form
			class="flex min-h-[100dvh] flex-col"
			hx-post={ addressAction(d.Address) }
			hx-swap="none"
			x-data={ addressState(d) }
			x-on:htmx:before-request="saving = true"
			x-on:htmx:after-request="saving = false">
			@navigation.ScreenHeader(tpl.When(d.Address == nil, "Add delivery address", "Edit delivery address"))
			<div class="flex-1 px-5 pb-5 pt-1">
				@addressField("name", "Full name", "user", "text", "name")
				<div class="h-3"></div>
				@addressField("phone", "Mobile number", "phone", "tel", "tel")
				<div class="h-3"></div>
				@addressField("line", "Hostel and room, or block and shop", "house", "text", "street-address")
				<p class="mt-5 text-[14px] font-bold text-text">Save as</p>
				<input type="hidden" name="label" x-bind:value="label"/>
				<input type="hidden" name="city" x-bind:value="city"/>
				<div class="mt-2.5 flex flex-wrap gap-2.5" role="radiogroup" aria-label="Save as">
					for _, l := range []string{"home", "office", "other"} {
						<button
							type="button"
							role="radio"
							x-bind:aria-checked={ "label === '" + l + "'" }
							x-on:click={ "label = '" + l + "'" }
							class="flex min-h-touch items-center rounded-[20px] px-4 text-[13px] font-semibold"
							x-bind:class={ "label === '" + l + "' ? 'bg-text text-white' : 'bg-surface text-text'" }>
							@ui.Icon(addressIcon(l), "h-[15px] w-[15px]")
							<span class="ml-1.5">{ shop.TitleCase(l) }</span>
						</button>
					}
				</div>
				<div class="mt-5" x-show="city.trim() !== ''">
					<div class="flex items-start rounded bg-[#E8F5E9] p-3.5 text-strong" x-show="serviceable">
						@ui.Icon("circle-check", "h-5 w-5 shrink-0")
						<div class="ml-2.5">
							<p class="text-[14px] font-bold">We deliver here</p>
							<p class="mt-0.5 text-[12px] leading-[1.4]">Porters reach this area in about { shop.DeliveryETA }.</p>
						</div>
					</div>
					<div class="flex items-start rounded bg-[#FDECEA] p-3.5 text-danger" x-show="!serviceable" x-cloak>
						@ui.Icon("circle-alert", "h-5 w-5 shrink-0")
						<div class="ml-2.5">
							<p class="text-[14px] font-bold">Not available in your location</p>
							<p class="mt-0.5 text-[12px] leading-[1.4]" x-text={ "`We do not deliver to ${city.trim()} yet. We currently serve " + strings.Join(d.Cities, ", ") + ".`" }></p>
						</div>
					</div>
				</div>
				<p class="mt-4 text-[14px] font-bold text-text">Where we deliver</p>
				<div class="mt-2.5 flex flex-wrap gap-2">
					for _, c := range d.Cities {
						<button
							type="button"
							x-on:click={ "city = " + jsonArg(c) }
							class="flex h-8 items-center rounded-lg border border-track px-3 text-[13px] font-semibold text-text"
							x-bind:class={ "city.trim() === " + jsonArg(c) + " ? 'bg-lime' : 'bg-surface'" }>
							{ c }
						</button>
					}
				</div>
			</div>
			<div class="sticky bottom-0 bg-canvas">
				<p class="flex items-center px-5 py-2 text-[13px] font-semibold text-danger" x-show="touched && problem" x-cloak aria-live="polite">
					@ui.Icon("circle-alert", "h-[15px] w-[15px] shrink-0")
					<span class="ml-1.5" x-text="problem"></span>
				</p>
				<div class="px-5 pb-[calc(16px+env(safe-area-inset-bottom))] pt-2">
					<button type="submit" class={ ui.ButtonClass(true) + " w-full" } x-bind:disabled="saving || problem !== null" disabled>
						<span class="h-[15px] w-[15px] shrink-0 animate-spin rounded-full border-2 border-white border-t-transparent" x-show="saving" x-cloak></span>
						<span class="truncate" x-text="saving ? 'Saving…' : 'Save address'">Save address</span>
					</button>
				</div>
			</div>
		</form>
	</main>
}

// addressField is _Field: surface, a muted icon, and a floating label.
templ addressField(name, label, icon, kind, autocomplete string) {
	<div class="flex items-center rounded bg-surface px-4 focus-within:ring-2 focus-within:ring-strong">
		@ui.Icon(icon, "h-[18px] w-[18px] shrink-0 text-muted")
		<div class="relative ml-3 h-14 min-w-0 flex-1">
			<input
				id={ "address-" + name }
				name={ name }
				type={ kind }
				autocomplete={ autocomplete }
				x-model={ name }
				x-on:input="touched = true"
				placeholder=" "
				class="peer h-full w-full bg-transparent pt-4 text-body text-text outline-none"/>
			<label for={ "address-" + name } class="pointer-events-none absolute left-0 top-[18px] max-w-full truncate text-body text-muted transition-all duration-150 peer-focus:top-2 peer-focus:text-[12px] peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-[12px]">{ label }</label>
		</div>
	</div>
}

func addressAction(a *backend.Address) string {
	if a == nil {
		return "/account/addresses"
	}
	return "/account/addresses/" + a.ID
}

// addressState seeds the form's Alpine state and its one-problem-at-a-time
// check (_problem in location_screen.dart).
func addressState(d AddressFormData) string {
	a := backend.Address{Label: "home"}
	if d.Address != nil {
		a = *d.Address
	}
	city := a.City
	if city == "" && len(d.Cities) > 0 {
		city = d.Cities[0]
	}
	return "{ name: " + jsonArg(a.Name) + ", phone: " + jsonArg(a.Phone) + ", line: " + jsonArg(a.Line) +
		", city: " + jsonArg(city) + ", label: " + jsonArg(tpl.When(a.Label == "", "home", a.Label)) +
		", cities: " + jsonArg(d.Cities) + ", touched: " + tpl.When(d.Address != nil, "true", "false") + ", saving: false," +
		" get serviceable() { return this.cities.includes(this.city.trim()) }," +
		" get problem() {" +
		" if (!this.name.trim()) return 'Enter the recipient name.';" +
		" if (!/^(?:\\+91[ -]?)?[6-9][0-9]{9}$/.test(this.phone.trim())) return 'Enter a valid 10-digit Indian mobile number.';" +
		" if (!this.line.trim()) return 'Enter the hostel and room, or block and shop.';" +
		" if (!this.serviceable) return `We do not deliver to ${this.city.trim()} yet.`;" +
		" return null } }"
}

func addressIcon(label string) string {
	switch label {
	case "office":
		return "briefcase"
	case "other":
		return "map-pin"
	}
	return "house"
}

func addressTitle(a backend.Address) string {
	return shop.TitleCase(tpl.When(a.Label == "", "home", a.Label))
}

func addressFull(a backend.Address) string {
	return strings.TrimSpace(a.Line + ", " + a.City + " " + a.Pincode)
}

func addressSummary(a backend.Address) string {
	var parts []string
	for _, v := range []string{a.Name, a.Phone, addressFull(a)} {
		if v != "" {
			parts = append(parts, v)
		}
	}
	return strings.Join(parts, " · ")
}
