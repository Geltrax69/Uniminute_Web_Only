package pages

// stores.templ — ShopsScreen and ShopScreen. The list: every store (or one
// department's), a surface row each with its picture, tagline and delivery
// time. The storefront: back, the cover picture, name and tagline, three info
// chips, and everything the shop sells.

import (
	"net/url"
	"strconv"

	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/navigation"
	"lamazon/website/templates/components/product"
	"lamazon/website/templates/components/ui"
	"lamazon/website/templates/layouts"
	"lamazon/website/tpl"
	"lamazon/website/viewdata"
)

type StoresPageData struct {
	Page   viewdata.Page
	Tab    string // "" for every store
	Stores []backend.Shop
}

templ StoresPage(d StoresPageData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", storesBody(d))
}

templ storesBody(d StoresPageData) {
	<main id="main" class="mx-auto w-full max-w-[760px] pb-[calc(100px+env(safe-area-inset-bottom))] lg:max-w-[1180px]">
		@navigation.ScreenHeader(storesTitle(d.Tab))
		if len(d.Stores) == 0 {
			<p class="p-8 pt-24 text-center text-body text-muted">No stores in this category yet.</p>
		} else {
			<div class="px-5 pt-1 lg:grid lg:grid-cols-2 lg:gap-4 xl:grid-cols-3">
				for _, s := range d.Stores {
					<a href={ templ.SafeURL("/store/" + url.PathEscape(s.Name)) } class="mb-3 lg:mb-0 flex items-center rounded-featured bg-surface p-2.5 hover:bg-[#F9F8F2]">
						<span class="flex h-[76px] w-[76px] shrink-0 items-center justify-center overflow-hidden rounded-small">
							@storeImage(s.ImageURL, 160)
						</span>
						<span class="ml-3 flex min-w-0 flex-1 flex-col justify-center">
							<span class="truncate text-[15px] font-bold text-text">{ s.Name }</span>
							<span class="mt-[3px] line-clamp-2 text-[12px] leading-[1.3] text-muted">{ s.Tagline }</span>
							<span class="mt-1.5 flex items-center text-muted">
								@ui.Icon("timer", "h-3 w-3")
								<span class="ml-1 text-[11.5px]">{ tpl.When(s.ClosedToday,"Closed today · back tomorrow",shop.DeliveryETA) }</span>
							</span>
						</span>
						@ui.Icon("chevron-right", "ml-2 h-[18px] w-[18px] shrink-0 text-muted")
					</a>
				}
			</div>
		}
	</main>
	@navigation.BottomNav(d.Page, "")
}

type StorePageData struct {
	Page             viewdata.Page
	Store            backend.Shop
	Products         []backend.Product
	Sections         []StoreSection
	Query            string
	SelectedCategory string
}

templ StorePage(d StorePageData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", withTopBar(d.Page, storeBody(d)))
}

templ storeBody(d StorePageData) {
	<main id="main" class="store-menu mx-auto w-full max-w-shell px-5 pb-[calc(100px+env(safe-area-inset-bottom))] pt-2" x-data={ "storeMenu(" + jsonArg(d.SelectedCategory) + "," + jsonArg(storeMenuConfig(d)) + "," + jsonArg(d.Query) + ")" }>
		@ui.TactileButton("arrow-left", "Back", 44, "", templ.Attributes{
			"x-data":     "",
			"x-on:click": "history.length > 1 ? history.back() : location.assign('/')",
		})
		<div class="mt-3 flex h-40 items-center justify-center overflow-hidden rounded-[24px]">
			@storeImage(d.Store.ImageURL, 0)
		</div>
		<h1 class="editorial-heading mt-5 text-[38px] text-text md:text-[48px]">{ d.Store.Name }</h1>
		if d.Store.Tagline != "" {
			<p class="mt-2 max-w-[65ch] text-[16px] leading-[24px] text-muted">{ d.Store.Tagline }</p>
		}
		if d.Store.ClosedToday {
 <p role="status" class="mt-4 rounded-small bg-surface p-4 text-[14px] font-semibold text-warning">Closed today. Browse the menu and come back tomorrow to order.</p>
 }
		<div class="mt-2.5 flex flex-wrap gap-2">
			@infoChip("truck", "Local delivery")
			@infoChip("wallet", "Online or cash")
		</div>
		<div class="mt-10 flex items-baseline gap-2">
			<h2 id="store-menu-results" x-ref="results" tabindex="-1" class="editorial-heading scroll-mt-6 text-[30px] text-text focus:outline-none lg:scroll-mt-28">{ tpl.When(d.Store.Tab == "Food", "Menu", "Products") }</h2>
			<span class="text-[15px] font-medium tabular-nums text-muted" x-text="'(' + count + ')'">({ strconv.Itoa(storeMenuCount(d)) })</span>
		</div>
		if len(d.Products) == 0 {
			<p class="py-10 text-center text-[14px] text-muted">No products listed yet</p>
		} else {
			<form method="get" role="search" aria-label={ "Search in " + d.Store.Name } class="mt-5 flex min-h-12 max-w-[620px] items-center gap-3 rounded-small bg-surface px-4 ring-1 ring-strong/15 focus-within:ring-2 focus-within:ring-strong" x-on:submit.prevent="search($refs.shopSearch.value)">
				@ui.Icon("search", "h-5 w-5 shrink-0 text-muted")
				<label for="shop-search" class="sr-only">Search this shop’s items</label>
				<input id="shop-search" x-ref="shopSearch" type="search" name="q" value={ d.Query } placeholder={ "Search in " + d.Store.Name } autocomplete="off" class="min-w-0 flex-1 bg-transparent py-3 text-[15px] text-text outline-none placeholder:text-muted" x-bind:value="query" x-on:input="search($event.target.value)"/>
				<button type="button" x-show="query" x-cloak aria-label="Clear shop search" x-on:click="search(''); $refs.shopSearch.focus()" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-muted hover:text-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-strong">
					@ui.Icon("x", "h-4 w-4")
				</button>
				<noscript><button type="submit" class="min-h-11 px-3 text-[14px] font-semibold text-strong">Search</button></noscript>
			</form>
			<p role="status" aria-live="polite" aria-atomic="true" class="sr-only" x-text="query.trim() ? count + (count === 1 ? ' item found in this shop' : ' items found in this shop') : ''"></p>
			<nav aria-label="Store categories" class="mt-5 hidden flex-wrap gap-2 lg:flex">
				@storeCategoryLink("", "All items", storeAllCount(d), d.SelectedCategory, d.Query)
				for _, section := range d.Sections {
					@storeCategoryLink(section.Name, section.Name, storeSectionCount(section, d.Query), d.SelectedCategory, d.Query)
				}
			</nav>
			<div x-cloak x-show="loading || offline" role="status" aria-live="polite" class="mt-5 rounded-small bg-surface p-4">
				<p class="text-[14px] font-medium text-strong" x-text="offline ? 'You’re offline. Reconnect to load menu images.' : slow ? 'Still loading menu images. Your connection may be slow…' : 'Loading menu images…'"></p>
				<div x-show="loading &amp;&amp; !offline" role="progressbar" aria-label="Loading menu images" class="mt-3 h-1 overflow-hidden rounded-full bg-strong/10">
					<div class="lw-progress h-full w-1/3 rounded-full bg-strong"></div>
				</div>
			</div>
			<div x-ref="products" aria-busy="false" x-bind:aria-busy="loading ? 'true' : 'false'" class="mt-8 space-y-10">
				for _, section := range d.Sections {
					<section id={ section.ID } aria-labelledby={ section.ID + "-title" } x-show={ "showSection(" + jsonArg(section.Name) + ")" } style={ templ.SafeCSS(tpl.When((d.SelectedCategory != "" && d.SelectedCategory != section.Name) || storeSectionCount(section, d.Query) == 0, "display:none", "")) }>
						<h3 id={ section.ID + "-title" } class="mb-4 flex items-baseline gap-2 text-[21px] font-semibold leading-7 text-text">
							{ section.Name }
							<span class="text-[14px] font-normal tabular-nums text-muted" x-text={ "'(' + sectionCount(" + jsonArg(section.Name) + ") + ')'" }>({ strconv.Itoa(storeSectionCount(section, d.Query)) })</span>
						</h3>
						@product.Grid(section.Products, product.GridOpts{ID: section.ID + "-products", StoreSearch: true, StoreQuery: d.Query, Spaced: true, Wishlist: d.Page.Wishlist, QuickAdd: product.FoodOrGrocery})
					</section>
				}
			</div>
			<div x-show="count === 0" style={ templ.SafeCSS(tpl.When(storeMenuCount(d) != 0, "display:none", "")) } class="py-12 text-center">
				<h3 class="text-[20px] font-semibold text-text">No matching items</h3>
				<p class="mt-2 text-[14px] leading-5 text-muted">Try a different item name or clear your search to browse this shop.</p>
				<button type="button" x-on:click="active = ''; search(''); $refs.shopSearch.focus()" class="mt-4 min-h-11 rounded-full bg-strong px-5 text-[14px] font-semibold text-white">Clear search</button>
			</div>
			<button type="button" aria-haspopup="dialog" aria-controls="store-category-menu" x-bind:aria-expanded="menuOpen" x-on:click="openMenu()" class="fixed bottom-[calc(20px+env(safe-area-inset-bottom))] right-5 z-40 inline-flex min-h-14 items-center gap-2 rounded-full bg-strong px-5 text-[15px] font-semibold text-white shadow-raised focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-strong lg:hidden">
				@ui.Icon("menu", "h-5 w-5")
				Menu
			</button>
			<dialog id="store-category-menu" x-ref="menu" x-on:close="menuOpen = false" x-on:click="if ($event.target === $el) $el.close()" aria-labelledby="store-category-menu-title" class="store-floating-menu fixed bottom-[calc(20px+env(safe-area-inset-bottom))] left-auto right-5 top-auto m-0 max-h-none w-[min(320px,calc(100vw-48px))] max-w-none overflow-visible border-0 bg-transparent p-0 text-text backdrop:bg-black/60">
				<div class="max-h-[calc(100dvh-140px-env(safe-area-inset-bottom))] overflow-y-auto overscroll-contain rounded-[24px] bg-surface p-3 shadow-raised">
					<h2 id="store-category-menu-title" class="sr-only">Browse categories</h2>
					<nav aria-label="Menu categories" class="flex flex-col gap-1">
						@storeCategoryLink("", "All items", storeAllCount(d), d.SelectedCategory, d.Query)
						for _, section := range d.Sections {
							@storeCategoryLink(section.Name, section.Name, storeSectionCount(section, d.Query), d.SelectedCategory, d.Query)
						}
					</nav>
				</div>
				<div class="mt-3 flex justify-end">
					<button type="button" aria-label="Close menu" x-on:click="$refs.menu.close()" class="inline-flex min-h-14 items-center gap-2 rounded-[18px] bg-strong px-5 text-[16px] font-semibold text-white shadow-raised focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime">
						@ui.Icon("x", "h-5 w-5")
						Close
					</button>
				</div>
			</dialog>
		}
	</main>
}

// Real links keep category selection usable without JavaScript.
templ storeCategoryLink(name, label string, count int, selected, query string) {
	<a href={ templ.SafeURL(storeCategoryURL(name, query)) } x-on:click.prevent={ "choose(" + jsonArg(name) + ")" } aria-current={ tpl.When(selected == name, "true", "false") } x-bind:aria-current={ "active === " + jsonArg(name) + " ? 'true' : 'false'" } class="inline-flex min-h-touch items-center justify-between gap-3 rounded-small bg-surface px-4 py-2.5 text-[14px] font-medium text-strong hover:bg-strong/[.06] aria-[current=true]:bg-strong aria-[current=true]:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-strong">
		<span>{ label }</span>
		<span class="text-[12px] tabular-nums" x-text={ tpl.When(name == "", "allCount", "sectionCount("+jsonArg(name)+")") }>{ strconv.Itoa(count) }</span>
	</a>
}

// storeImage is NetImage padded to 16:9: the whole picture, never cropped.
templ storeImage(src string, width int) {
	if src == "" {
		<span class="flex h-full w-full items-center justify-center bg-img-ground">
			@ui.Icon("image-off", "h-6 w-6 text-muted")
		</span>
	} else if width > 0 {
		<img src={ templ.URL(shop.ThumbWidth(src, width)) } alt="" loading="lazy" class="h-full w-full object-contain"/>
	} else {
		<img src={ templ.URL(src) } alt="" class="h-full w-full object-contain"/>
	}
}

templ infoChip(icon, label string) {
	<span class="flex items-center rounded-featured bg-white px-3 py-[7px] text-text">
		@ui.Icon(icon, "h-[13px] w-[13px]")
		<span class="ml-[5px] text-[12px] font-semibold">{ label }</span>
	</span>
}

func storesTitle(tab string) string {
	if tab == "" {
		return "Stores near you"
	}
	return tab + " stores"
}
