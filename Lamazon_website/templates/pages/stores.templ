package pages

// stores.templ — ShopsScreen and ShopScreen. The list: every store (or one
// department's), a surface row each with its picture, tagline and delivery
// time. The storefront: back, the cover picture, name and tagline, three info
// chips, and everything the shop sells.

import (
	"net/url"
	"strconv"

	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/navigation"
	"lamazon/website/templates/components/product"
	"lamazon/website/templates/components/ui"
	"lamazon/website/templates/layouts"
	"lamazon/website/viewdata"
)

type StoresPageData struct {
	Page   viewdata.Page
	Tab    string // "" for every store
	Stores []backend.Shop
}

templ StoresPage(d StoresPageData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", storesBody(d))
}

templ storesBody(d StoresPageData) {
	<main id="main" class="mx-auto w-full max-w-[760px] pb-[calc(100px+env(safe-area-inset-bottom))] lg:max-w-[1180px]">
		@navigation.ScreenHeader(storesTitle(d.Tab))
		if len(d.Stores) == 0 {
			<p class="p-8 pt-24 text-center text-body text-muted">No stores in this category yet.</p>
		} else {
			<div class="px-5 pt-1 lg:grid lg:grid-cols-2 lg:gap-4 xl:grid-cols-3">
				for _, s := range d.Stores {
					<a href={ templ.SafeURL("/store/" + url.PathEscape(s.Name)) } class="mb-3 lg:mb-0 flex items-center rounded-featured bg-surface p-2.5 hover:bg-[#F9F8F2]">
						<span class="flex h-[76px] w-[76px] shrink-0 items-center justify-center overflow-hidden rounded-small">
							@storeImage(s.ImageURL, 160)
						</span>
						<span class="ml-3 flex min-w-0 flex-1 flex-col justify-center">
							<span class="truncate text-[15px] font-bold text-text">{ s.Name }</span>
							<span class="mt-[3px] line-clamp-2 text-[12px] leading-[1.3] text-muted">{ s.Tagline }</span>
							<span class="mt-1.5 flex items-center text-muted">
								@ui.Icon("timer", "h-3 w-3")
								<span class="ml-1 text-[11.5px]">{ shop.DeliveryETA }</span>
							</span>
						</span>
						@ui.Icon("chevron-right", "ml-2 h-[18px] w-[18px] shrink-0 text-muted")
					</a>
				}
			</div>
		}
	</main>
	@navigation.BottomNav(d.Page, "")
}

type StorePageData struct {
	Page     viewdata.Page
	Store    backend.Shop
	Products []backend.Product
}

templ StorePage(d StorePageData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", withTopBar(d.Page, storeBody(d)))
}

templ storeBody(d StorePageData) {
	<main id="main" class="mx-auto w-full max-w-shell px-5 pb-6 pt-2">
		@ui.TactileButton("arrow-left", "Back", 44, "", templ.Attributes{
			"x-data":     "",
			"x-on:click": "history.length > 1 ? history.back() : location.assign('/')",
		})
		<div class="mt-3 flex h-40 items-center justify-center overflow-hidden rounded-[24px]">
			@storeImage(d.Store.ImageURL, 0)
		</div>
		<h1 class="mt-3.5 text-title text-text">{ d.Store.Name }</h1>
		if d.Store.Tagline != "" {
			<p class="mt-1 text-[13px] text-muted">{ d.Store.Tagline }</p>
		}
		<div class="mt-2.5 flex flex-wrap gap-2">
			@infoChip("truck", "Local delivery")
			@infoChip("banknote", "Cash on delivery")
			@infoChip("star", "4.5")
		</div>
		<h2 class="mt-[22px] text-[16px] font-bold text-text">Products ({ strconv.Itoa(len(d.Products)) })</h2>
		<div class="mt-3">
			if len(d.Products) == 0 {
				<p class="py-10 text-center text-[14px] text-muted">No products listed yet</p>
			} else {
				@product.Grid(d.Products, product.GridOpts{
					Spaced:    true,
					ShowStore: false,
					Wishlist:  d.Page.Wishlist,
					QuickAdd:  product.FoodOrGrocery,
				})
			}
		</div>
	</main>
}

// storeImage is NetImage padded to 16:9: the whole picture, never cropped.
templ storeImage(src string, width int) {
	if src == "" {
		<span class="flex h-full w-full items-center justify-center bg-img-ground">
			@ui.Icon("image-off", "h-6 w-6 text-muted")
		</span>
	} else if width > 0 {
		<img src={ templ.URL(shop.ThumbWidth(src, width)) } alt="" loading="lazy" class="h-full w-full object-contain"/>
	} else {
		<img src={ templ.URL(src) } alt="" class="h-full w-full object-contain"/>
	}
}

templ infoChip(icon, label string) {
	<span class="flex items-center rounded-featured bg-white px-3 py-[7px] text-text">
		@ui.Icon(icon, "h-[13px] w-[13px]")
		<span class="ml-[5px] text-[12px] font-semibold">{ label }</span>
	</span>
}

func storesTitle(tab string) string {
	if tab == "" {
		return "Stores near you"
	}
	return tab + " stores"
}
