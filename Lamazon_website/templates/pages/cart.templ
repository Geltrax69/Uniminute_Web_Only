package pages

// cart.templ — CartScreen: ScreenHeader "My Cart", the cart body, and the
// bottom bar with Cart selected. When opening the cart had to shrink a line to
// the shop's stock, a message says so once the page is up.

import (
	"lamazon/website/templates/components/cart"
	"lamazon/website/templates/components/navigation"
	"lamazon/website/templates/layouts"
	"lamazon/website/viewdata"
)

type CartPageData struct {
	Page    viewdata.Page
	Cart    cart.Data
	Trimmed []string // names of lines reduced to what the shop has
}

templ CartPage(d CartPageData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", cartPage(d))
}

templ cartPage(d CartPageData) {
	<main id="main" class="pb-[calc(108px+env(safe-area-inset-bottom))]">
		@navigation.ScreenHeader("My Cart")
		@cart.Body(d.Cart)
		if len(d.Trimmed) > 0 {
			<div
				x-data
				x-init={ "setTimeout(() => window.dispatchEvent(new CustomEvent('lw:toast', {detail: {message: " + jsonArg(trimmedMessage(d.Trimmed)) + "}})), 0)" }></div>
		}
	</main>
	@navigation.BottomNav(d.Page, "cart")
}

func trimmedMessage(names []string) string {
	if len(names) == 1 {
		return "Only some of \"" + names[0] + "\" is left — we reduced it to what the shop has."
	}
	return "Some items ran low. We reduced them to what the shop has."
}
