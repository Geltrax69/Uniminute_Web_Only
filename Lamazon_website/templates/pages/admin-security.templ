package pages

import (
 "strconv"
 "lamazon/website/templates/components/ui"
)

templ adminSecurity(d AdminData){
 if d.ReportError!="" {
<p class="mb-5 rounded-[12px] bg-danger/[.06] p-4 text-[14px] leading-6 text-danger" role="alert">{d.ReportError}</p>
}

 <section class="mb-7 rounded-[16px] bg-surface p-5 sm:p-6" x-data={"adminSecuritySettings("+jsonArg(d.MFA)+")"} aria-labelledby="admin-authenticator-title">
  <div class="flex flex-wrap items-start justify-between gap-3"><div><h2 id="admin-authenticator-title" class="text-[19px] font-semibold text-text">Admin authenticator</h2><p class="mt-2 max-w-[65ch] text-[14px] leading-6 text-muted">Require a six-digit code in addition to your password. Use an authenticator app and keep the recovery codes somewhere secure.</p></div><span class="rounded-full bg-strong/[.06] px-3 py-2 text-[13px] font-semibold text-strong" x-text="enabled ? 'Enabled' : 'Not enabled'">Authenticator status</span></div>
  <p class="mt-4 text-[13px] leading-6 text-danger" x-show="!configured" x-cloak>Authenticator setup needs the server encryption key. Contact the server administrator.</p>
  <p class="mt-4 text-[13px] text-muted" x-show="enabled" x-cloak><span x-text="remaining"></span> recovery codes remaining. Each code can be used once.</p>
  <form class="mt-5 max-w-[520px]" x-on:submit.prevent="run(secret ? 'confirm' : (enabled ? 'disable' : 'begin'))">
   <label class="block text-[13px] font-semibold text-text" for="security-admin-password">Current admin password</label><input id="security-admin-password" type="password" autocomplete="current-password" x-model="password" required maxlength="1024" class="mt-2 min-h-12 w-full rounded-[12px] bg-canvas px-4 text-body text-text outline-none focus:ring-2 focus:ring-strong"/>
   <div class="mt-5" x-show="secret" x-cloak><h3 class="text-[15px] font-semibold text-text">Add this setup key to your authenticator</h3><p class="mt-2 text-[13px] leading-6 text-muted">Choose “Enter a setup key”, set the account to Uniminute, and select time-based codes. Setup expires after 10 minutes.</p><output class="mt-3 block select-all break-all rounded-[12px] bg-canvas p-4 text-[15px] font-semibold leading-6 tracking-wide text-text" x-text="secret"></output><a x-bind:href="uri" class="mt-2 inline-flex min-h-11 items-center text-[13px] font-semibold text-strong">Open in authenticator app →</a></div>
   <div class="mt-4" x-show="secret || enabled" x-cloak><label class="block text-[13px] font-semibold text-text" for="security-admin-code">Authenticator code or unused recovery code</label><input id="security-admin-code" autocomplete="one-time-code" x-model="code" x-bind:required="!!secret || enabled" maxlength="24" class="mt-2 min-h-12 w-full rounded-[12px] bg-canvas px-4 text-body text-text outline-none focus:ring-2 focus:ring-strong"/></div>
   <p class="mt-4 text-[13px] leading-6 text-muted" x-show="enabled" x-cloak>Disabling removes the second sign-in step. Your password and a current authenticator or recovery code are required.</p>
   <p class="mt-4 text-[14px] leading-6 text-danger" role="alert" x-show="error" x-text="error" x-cloak></p><p class="mt-4 text-[14px] leading-6 text-strong" role="status" x-show="notice" x-text="notice" x-cloak></p>
   <button type="submit" class={ui.ButtonClass(true)+" mt-5"} x-bind:disabled="busy || !configured"><span x-text="busy ? 'Saving security settings…' : (secret ? 'Verify and enable' : (enabled ? 'Disable authenticator' : 'Set up authenticator'))">Set up authenticator</span></button>
  </form>
  <div class="mt-6 max-w-[640px] rounded-[12px] bg-canvas p-5" x-show="recoveryCodes.length" x-cloak><h3 class="text-[16px] font-semibold text-text">Save your recovery codes now</h3><p class="mt-2 text-[13px] leading-6 text-muted">These codes are shown once. Each replaces one authenticator code if your phone is unavailable. Existing admin sessions on other devices were signed out.</p><ul class="mt-4 grid gap-2 sm:grid-cols-2"><template x-for="item in recoveryCodes" x-bind:key="item"><li class="select-all break-all text-[14px] font-semibold text-text" x-text="item"></li></template></ul><button type="button" class={ui.ButtonClass(false)+" mt-4"} x-on:click="downloadCodes()">Download recovery codes</button><button type="button" class="ml-3 min-h-11 px-3 text-[13px] font-semibold text-strong" x-on:click="recoveryCodes = []; notice = 'Recovery codes saved. Authenticator protection is enabled.'">I saved them</button></div>
 </section>
 <section class="mb-7 rounded-[16px] bg-surface p-5"><h2 class="text-[18px] font-semibold text-text">Security controls</h2><dl class="mt-4 grid gap-4 text-[14px] sm:grid-cols-2"><div><dt class="font-semibold text-text">Accounts and sessions</dt><dd class="mt-1 leading-6 text-muted">HTTPS-only production cookies, origin checks, login budgets, stronger password hashing and server-side sign-out.</dd></div><div><dt class="font-semibold text-text">Payments and uploads</dt><dd class="mt-1 leading-6 text-muted">Shared payment budgets and retry checks. Images have size/dimension checks, processing limits and upload quotas.</dd></div></dl><p class="mt-5 max-w-[80ch] text-[13px] leading-6 text-muted">Server controls do not replace operational monitoring. Keep API credentials private, rotate exposed secrets, and verify that backups can be restored. Authenticator protection starts after enrollment above.</p></section>
 @adminOperations(d)
 <section aria-labelledby="admin-security-audit-title"><h2 id="admin-security-audit-title" class="mb-3 text-[18px] font-semibold text-text">Recent admin actions</h2>
  if len(d.Audit)==0 {
@reportEmpty("No admin actions recorded", "Changes made after this security update will appear here. Passwords, codes and request bodies are excluded.")
}
 else {

   <div class="overflow-x-auto rounded-[16px] bg-surface" role="region" aria-label="Recent administrator audit events" tabindex="0"><table class="admin-report-table w-full min-w-[560px] text-left text-[13px]"><thead><tr><th scope="col">Time (IST)</th><th scope="col">Admin</th><th scope="col">Action</th><th scope="col">HTTP result</th></tr></thead><tbody>
for _,event:=range d.Audit {
<tr><td>{sv(event,"time")}</td><td>{sv(event,"actor")}</td><td>{sv(event,"action")}</td><td>{strconv.Itoa(int(nv(event,"status")))}</td></tr>
}
</tbody></table></div>
  }
 </section>
}


templ adminOperations(d AdminData) {
 <section class="mb-7" aria-labelledby="operations-health-title">
  <h2 id="operations-health-title" class="mb-3 text-[18px] font-semibold text-text">Backup and service health</h2>
  <div class="overflow-x-auto rounded-[16px] bg-surface" role="region" aria-label="Backup and service health" tabindex="0"><table class="admin-report-table w-full min-w-[560px] text-left text-[13px]"><thead><tr><th scope="col">Control</th><th scope="col">Status</th><th scope="col">Last check / success</th></tr></thead><tbody>
   <tr><th scope="row" class="font-medium">Encrypted database backup</th><td>{operationLabel(d.Operations,"backup")}</td><td>{operationTime(d.Operations,"backup","lastBackup")}</td></tr>
   <tr><th scope="row" class="font-medium">Backup restore verification</th><td>{operationLabel(d.Operations,"restore")}</td><td>{operationTime(d.Operations,"backup","lastRestoreCheck")}</td></tr>
   <tr><th scope="row" class="font-medium">API and website</th><td>{operationLabel(d.Operations,"health")}</td><td>{operationTime(d.Operations,"health","checkedAt")}</td></tr>
  </tbody></table></div>
  <p class="mt-3 max-w-[80ch] text-[13px] leading-6 text-muted">Database backups run daily with 14-day server retention. Restore verification runs weekly in a disposable database. Service checks run every minute. External alert delivery and automated off-server storage need a configured destination.</p>
 </section>
}
