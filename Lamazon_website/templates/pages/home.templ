package pages

// home.templ — HomeScreen from home_screen.dart, section for section and in
// the same order: the service header, the search launch, the department
// strip, the campaign deck (or the department's own banner), "Around you",
// one titled shelf grid per department, the store rail, "Saved for later",
// the product grid with "Show N more", and the closing panel. The spacing
// between sections is the SizedBox heights the Flutter ListView uses.

import (
	"encoding/json"
	"net/url"
	"strconv"
	"strings"

	"lamazon/website/backend"
	"lamazon/website/shop"
	"lamazon/website/templates/components/navigation"
	"lamazon/website/templates/components/product"
	"lamazon/website/templates/components/ui"
	"lamazon/website/templates/layouts"
	"lamazon/website/tpl"
	"lamazon/website/viewdata"
)

// HomePage is _productPage: how many products the grid shows per step.
const HomePage = 12

type HomeData struct {
	Page        viewdata.Page
	Departments []backend.Category // top level, All not included
	Tab         string             // "All" or a department name
	Campaigns   []backend.Campaign // already scoped to Tab
	Offers      []backend.Product
	Shops       []backend.Shop
	Saved       []backend.Product
	Scoped      []backend.Product
	Faces       map[string]string // category -> a photograph it sells
	DeptOf      map[string]string // category -> department
	DeptIcons   map[string]string // department -> lucide icon
}

func (d HomeData) seasonGround() string {
	if d.Page.Season != nil {
		return d.Page.Season.Ground
	}
	return ""
}

// scope is the department name, or "" on All.
func (d HomeData) scope() string {
	if d.Tab == "All" {
		return ""
	}
	return d.Tab
}

templ Home(d HomeData) {
	@layouts.Base(d.Page.Title, d.Page.Description, "", homeBody(d))
}

templ homeBody(d HomeData) {
	<div style={ templ.SafeCSS(d.Page.SeasonCSS()) }>
		<main id="main" class="mx-auto max-w-[1464px] px-gutter pb-[calc(108px+env(safe-area-inset-bottom))] pt-2 lg:pt-6">
			// On a desktop the top bar already carries these two.
			<div class="lg:hidden">
				@serviceHeader(d.Page)
				<div class="h-3"></div>
				@searchLaunch(d)
				<div class="h-4"></div>
			</div>
			@departmentStrip(d)
			<div class="h-[26px] md:h-9"></div>
			if len(d.Campaigns) > 0 {
				@campaignDeck(d)
			} else {
				@campaignBanner(backend.Campaign{
					Title:    shop.DepartmentHeadline(d.Tab),
					Subtitle: "A considered edit from stores in your area.",
					Category: d.scope(),
					Colour:   "#143E32",
					CTA:      "Explore the edit",
				}, d.seasonGround(), searchHref(d.scope(), d.scope()))
			}
			if len(d.Offers) > 0 {
				<div class="home-section-gap"></div>
				@shelf("Around you", "Fresh picks with a real saving", d.Offers, d.Page.Wishlist, searchHref("", d.scope()))
			}
			// Dart's dangling else: the per-department grids draw on All only.
			if d.Tab == "All" {
				for _, dept := range d.Departments {
					if len(dept.Children) > 0 {
						<div class="home-section-gap"></div>
						@categorySection(dept.Name, dept.Name, firstCategories(dept.Children, 8), tabHref(dept.Name), d)
					}
				}
			}
			if len(d.Shops) > 0 {
				<div class="home-section-gap"></div>
				@sectionHeading("Stores near you", "Local storefronts, one tap away", storesHref(d.scope()), "See all")
				<div class="h-3.5"></div>
				@storeRail(d.Shops)
			}
			if len(d.Saved) > 0 {
				<div class="home-section-gap"></div>
				@shelf("Saved for later", "Your shortlist is waiting", d.Saved, d.Page.Wishlist, "/saved")
			}
			<div class="home-section-gap"></div>
			if len(d.Scoped) == 0 {
				@nothingHere(d.scope())
			} else {
				@sectionHeading(
					tpl.When(d.Tab == "All", "Discover local favourites", "Explore "+d.Tab),
					tpl.When(d.Tab == "All", "Real products from nearby shops", "Everything in this department"),
					searchHref("", d.scope()), "See all")
				<div class="h-3.5"></div>
				@product.Grid(firstProducts(d.Scoped, HomePage), product.GridOpts{
					ID:        "home-grid",
					ShowStore: shop.MixesStores(d.Scoped),
					Wishlist:  d.Page.Wishlist,
				})
				@HomeMore(d.Tab, HomePage, len(d.Scoped), false)
			}
			<div class="home-close-gap"></div>
			@homeClose()
		</main>
		@navigation.BottomNav(d.Page, "home")
	</div>
}

// HomeMore is the "Show N more" button. Its own fragment answer replaces it
// out of band, so the count stays honest as the grid grows.
templ HomeMore(tab string, shown, total int, oob bool) {
	<div id="home-more" { oobAttrs(oob)... }>
		if total > shown {
			<div class="h-5"></div>
			<div class="flex justify-center">
				@ui.ActionButtonIcon("Show "+strconv.Itoa(total-shown)+" more", "arrow-down", false, templ.Attributes{
					"hx-get":    "/fragments/home-products?tab=" + url.QueryEscape(tab) + "&offset=" + strconv.Itoa(shown),
					"hx-target": "#home-grid",
					"hx-swap":   "beforeend",
				})
			</div>
		}
	</div>
}

// HomeProducts answers "Show N more": the next cards, and the button again.
templ HomeProducts(items []backend.Product, wishlist map[string]bool, showStore bool, tab string, shown, total int) {
	@product.Cards(items, product.GridOpts{ShowStore: showStore, Wishlist: wishlist})
	@HomeMore(tab, shown, total, true)
}

// _ServiceHeader: who you are shopping with, and where it is going.
templ serviceHeader(p viewdata.Page) {
	<div class="rounded-featured px-4 pb-[15px] pt-4 shadow-raised" style="background-image:linear-gradient(to bottom right,var(--season-ground),var(--season-ground-shade))">
		<div class="h-1"></div>
		<h1 class="flex items-center gap-2 text-[22px] font-semibold leading-[28px] tracking-[-0.7px]" style="color:var(--season-ink)"><img src="/static/images/logo.png" alt="" class="h-7 w-7 shrink-0 rounded-md bg-white object-contain p-0.5"/> Uniminute</h1>
		<div class="h-0.5"></div>
		<a href={ templ.SafeURL(addressHref(p)) } class="inline-flex max-w-full items-center rounded-small pb-1">
			<span class="flex" style="color:var(--season-accent)">
				@ui.Icon("map-pin", "h-[15px] w-[15px]")
			</span>
			<span class="ml-[5px] min-w-0 truncate text-[13.5px] leading-[18px] tracking-[0.2px]" style="color:color-mix(in srgb,var(--season-ink) 82%,transparent)">{ addressText(p) }</span>
			<span class="ml-1 flex" style="color:var(--season-accent)">
				@ui.Icon("chevron-down", "h-4 w-4")
			</span>
		</a>
	</div>
}

// _SearchLaunch: a raised surface that opens search, the placeholder cycling
// a season's hints every four seconds.
templ searchLaunch(d HomeData) {
	{{ hints := seasonHints(d.Page) }}
	<a
		href={ templ.SafeURL(searchHref("", d.scope())) }
		aria-label="Search products and stores"
		class="flex items-center rounded-featured bg-surface px-4 py-3.5 shadow-raised"
		x-data={ "hints(" + jsonArg(hints) + ")" }>
		@ui.Icon("search", "h-[21px] w-[21px] text-strong")
		<span class="ml-3 min-w-0 flex-1 truncate text-center text-[15px] tracking-[0.2px] text-muted" aria-hidden="true" x-text="label">{ hintLabel(hints) }</span>
		@ui.Icon("arrow-up-right", "h-[18px] w-[18px] text-strong")
	</a>
}

// _DepartmentStrip: All, then every department on its artwork.
templ departmentStrip(d HomeData) {
	<nav aria-label="Departments">
		<ul class="bleed flex gap-[11px] overflow-x-auto pb-2 no-scrollbar">
			@departmentTile("All", "", 0, d.Tab == "All", true)
			for _, dept := range d.Departments {
				@departmentTile(dept.Name, dept.ImageURL, shop.AtlasIndex(dept.Name, ""), d.Tab == dept.Name, false)
			}
		</ul>
	</nav>
}

templ departmentTile(name, image string, atlas int, selected, isAll bool) {
	<li class="w-[74px] shrink-0">
		<a href={ templ.SafeURL(tabHref(name)) } { currentAttr(selected)... } class="flex h-[96px] flex-col items-center rounded-tile">
			<span
				class={ "flex h-[54px] w-[54px] shrink-0 items-center justify-center overflow-hidden rounded transition-[background-color,box-shadow] duration-[180ms] motion-reduce:transition-none " + tpl.When(selected, "shadow-tactile", "shadow-surface") }
				style={ templ.SafeCSS(tpl.When(selected, "background-color:var(--season-accent)", "background-color:#FFFDF8")) }>
				if isAll {
					<span class="flex" style={ templ.SafeCSS(tpl.When(selected, "color:var(--season-on-accent)", "color:#1D4939")) }>
						@ui.Icon("layout-grid", "h-6 w-6")
					</span>
				} else if image != "" {
					<img src={ templ.URL(shop.CatalogueImage(image, 160)) } alt="" loading="lazy" class="h-full w-full object-cover"/>
				} else {
					<span class="h-full w-full" style={ templ.SafeCSS(shop.AtlasStyle(atlas)) }></span>
				}
			</span>
			<span class={ "mt-1.5 line-clamp-2 text-center text-[11px] leading-[1.15] tracking-[0.1px] " + tpl.When(selected, "font-semibold text-strong", "text-text") }>{ name }</span>
		</a>
	</li>
}

// CampaignDeck: one banner at a time, advancing by itself (six seconds, twelve
// for a clip) unless reduced motion asks it not to, with arrows and dots.
templ campaignDeck(d HomeData) {
	<div x-data={ "deck(" + strconv.Itoa(len(d.Campaigns)) + "," + jsonArg(dwells(d.Campaigns)) + ")" }>
		for i, c := range d.Campaigns {
			if i == 0 {
				<div x-show="index === 0" x-transition.opacity.duration.220ms>
					@campaignBanner(c, d.seasonGround(), campaignHref(c, d.DeptOf))
				</div>
			} else {
				<div x-show={ "index === " + strconv.Itoa(i) } x-transition.opacity.duration.220ms x-cloak>
					@campaignBanner(c, d.seasonGround(), campaignHref(c, d.DeptOf))
				</div>
			}
		}
		if len(d.Campaigns) > 1 {
			<div class="mt-3 flex items-center justify-center">
				@ui.TactileButton("arrow-left", "Previous banner", 38, "", templ.Attributes{"x-on:click": "move(-1)"})
				<div class="mx-3 flex">
					for i := range d.Campaigns {
						<span
							class={ "mx-[3px] h-[7px] rounded-full transition-all duration-[180ms] motion-reduce:transition-none " + tpl.When(i == 0, "w-[22px] bg-strong", "w-[7px] bg-track") }
							x-bind:class={ "index === " + strconv.Itoa(i) + " ? 'w-[22px] bg-strong' : 'w-[7px] bg-track'" }></span>
					}
				</div>
				@ui.TactileButton("arrow-right", "Next banner", 38, "", templ.Attributes{"x-on:click": "move(1)"})
			</div>
		}
	</div>
}

// CampaignBanner: the palette's ground, the artwork from a quarter (a third,
// wide) of the way in, a wash over it, and the copy in the clear left side.
templ campaignBanner(c backend.Campaign, seasonGround, href string) {
	{{ pal := shop.ResolvePalette(c.Colour, seasonGround) }}
	<div class="banner-host">
		<a
			href={ templ.SafeURL(href) }
			class="banner block overflow-hidden rounded-featured shadow-raised"
			style={ templ.SafeCSS("background-color:" + pal.Background) }
			aria-label={ c.Title + ". " + c.CTA }>
			<div class="banner-art" aria-hidden="true">
				if c.ImageURL == "" {
					<img src="/static/images/icons/campaign-forest.webp" alt=""/>
				} else if shop.IsVideo(c.ImageURL) {
					<video src={ templ.URL(c.ImageURL) } autoplay muted loop playsinline></video>
				} else {
					<img src={ templ.URL(c.ImageURL) } alt="" loading="lazy"/>
				}
			</div>
			<div class="absolute inset-0" style={ templ.SafeCSS(bannerWash(pal.Background)) }></div>
			<div class="banner-copy">
				<span class="max-w-full truncate rounded-full bg-white/[.14] px-3 py-1.5 text-[11px] font-semibold leading-[15px] tracking-[1px]" style={ templ.SafeCSS("color:" + pal.Foreground) }>{ bannerTag(c) }</span>
				<h2 class="banner-title mt-4" style={ templ.SafeCSS("color:" + pal.Foreground) }>{ c.Title }</h2>
				if strings.TrimSpace(c.Subtitle) != "" {
					<p class="banner-sub mt-3 max-w-[42ch] text-[15px] leading-[22px] tracking-[0.1px]" style={ templ.SafeCSS("color:" + tpl.RGBA(pal.Foreground, .9)) }>{ c.Subtitle }</p>
				}
				<span
					class="mt-5 inline-flex min-h-[46px] max-w-full items-center rounded-[23px] px-4 py-2.5 text-[13px] font-semibold shadow-tactile"
					style={ templ.SafeCSS("background-image:linear-gradient(to bottom right," + tpl.Blend("#FFFFFF", .36, pal.Action) + "," + pal.Action + ");color:" + pal.ActionForeground) }>
					<span class="truncate">{ c.CTA }</span>
					@ui.Icon("arrow-right", "ml-[7px] h-4 w-4")
				</span>
			</div>
		</a>
	</div>
}

// SectionHeading: title, optional subtitle, and one "See all →" text button.
templ sectionHeading(title, subtitle, href, label string) {
	<div class="flex items-end">
		<div class="min-w-0 flex-1">
			<h2 class="editorial-heading editorial-section text-text">{ title }</h2>
			if subtitle != "" {
				<p class="mt-2 max-w-[62ch] text-[15px] leading-[23px] text-muted">{ subtitle }</p>
			}
		</div>
		if href != "" {
			<a href={ templ.SafeURL(href) } class="ml-2 inline-flex min-h-12 shrink-0 items-center rounded-full px-3 text-label text-strong hover:bg-strong/[.06]">
				{ label }
				@ui.Icon("arrow-right", "ml-1 h-4 w-4")
			</a>
		}
	</div>
}

// CollectionShelf: a titled horizontal rail of cards. Arrows scroll it on a
// wide screen; on a phone one arrow opens the whole list instead.
templ shelf(title, subtitle string, items []backend.Product, wishlist map[string]bool, seeAll string) {
	<section x-data>
		<div class="flex items-end">
			<div class="min-w-0 flex-1">
				<h2 class="editorial-heading editorial-section text-text">{ title }</h2>
				if subtitle != "" {
					<p class="mt-2 max-w-[62ch] text-[15px] leading-[23px] text-muted">{ subtitle }</p>
				}
			</div>
			<div class="ml-3 hidden gap-2 min-[720px]:flex">
				@ui.TactileButton("arrow-left", "Previous products", 40, "", templ.Attributes{"x-on:click": "$refs.rail.scrollBy({left: -$refs.rail.clientWidth * .84, behavior: 'smooth'})"})
				@ui.TactileButton("arrow-right", "Next products", 40, "", templ.Attributes{"x-on:click": "$refs.rail.scrollBy({left: $refs.rail.clientWidth * .84, behavior: 'smooth'})"})
			</div>
			if seeAll != "" {
				<div class="ml-3 min-[720px]:hidden">
					@ui.TactileButton("arrow-right", "Browse "+title, 40, "", templ.Attributes{"href": seeAll})
				</div>
			}
		</div>
		<div class="h-5"></div>
		<div x-ref="rail" class="bleed flex gap-3 overflow-x-auto pb-2.5 no-scrollbar">
			for _, p := range items {
				<div class="h-[292px] w-[166px] shrink-0">
					@product.Card(p, product.CardOpts{ShowStore: shop.MixesStores(items), QuickAdd: !p.HasOptions(), Wishlisted: wishlist[p.ID]})
				</div>
			}
		</div>
	</section>
}

// _CategorySection: one department's shelves as a titled grid of tiles.
templ categorySection(title, dept string, cats []backend.Category, seeAll string, d HomeData) {
	<section>
		@sectionHeading(title, "", seeAll, "See all")
		<div class="h-5"></div>
		<div class="cat-host">
			// On All each department shows six (eight on a desktop) and See all.
			<div class={ "cat-grid", templ.KV("limited", seeAll != "") }>
				for _, c := range cats {
					<a href={ templ.SafeURL(searchHref(c.Name, dept)) } aria-label={ "Browse " + c.Name } class="flex min-w-0 flex-col rounded-small bg-surface p-[7px] shadow-surface hover:bg-[#F9F8F2]">
						<span class="relative min-h-0 flex-1 overflow-hidden rounded-[9px]">
							@categoryVisual(c, dept, d)
						</span>
						<span class="mt-2 line-clamp-2 text-center text-[13px] font-medium leading-[17px] text-text">{ c.Name }</span>
					</a>
				}
			</div>
		</div>
	</section>
}

// CategoryVisual for a shelf: its own artwork, else a photograph of something
// it sells, else the season-coloured plate with the shelf's glyph.
templ categoryVisual(c backend.Category, dept string, d HomeData) {
	if c.ImageURL != "" {
		<img src={ templ.URL(shop.CatalogueImage(c.ImageURL, 300)) } alt="" loading="lazy" class="h-full w-full object-cover"/>
	} else if face := d.Faces[c.Name]; face != "" {
		<img src={ templ.URL(shop.Thumb(face)) } alt="" loading="lazy" class="h-full w-full object-cover"/>
	} else {
		<span class="flex h-full w-full items-center justify-center" style="background-image:linear-gradient(to bottom right,var(--season-ground),var(--season-plate-shade))">
			<span class="flex" style="color:color-mix(in srgb,var(--season-accent) 82%,transparent)">
				@ui.Icon(shop.Glyph(c.Name, d.DeptIcons[dept]), "h-7 w-7")
			</span>
		</span>
	}
}

// _StoreRail / _StoreTile.
templ storeRail(shops []backend.Shop) {
	<div class="bleed flex h-[116px] gap-3 overflow-x-auto pb-2.5 no-scrollbar">
		for _, s := range shops {
			<a href={ templ.SafeURL("/store/" + url.PathEscape(s.Name)) } class="flex w-[260px] shrink-0 items-center rounded-small bg-surface p-2.5 shadow-surface hover:bg-[#F9F8F2]">
				<span class="flex h-[84px] w-[84px] shrink-0 items-center justify-center overflow-hidden rounded-[9px]">
					if s.ImageURL != "" {
						<img src={ templ.URL(shop.ThumbWidth(s.ImageURL, 160)) } alt="" loading="lazy" class="h-full w-full object-contain"/>
					} else {
						<span class="flex h-full w-full items-center justify-center bg-img-ground">
							@ui.Icon("image-off", "h-6 w-6 text-muted")
						</span>
					}
				</span>
				<span class="ml-3 flex min-w-0 flex-1 flex-col justify-center">
					<span class="truncate text-[16px] font-semibold tracking-[-0.25px] text-text">{ s.Name }</span>
					<span class="mt-[3px] truncate text-[12.5px] leading-[15px] tracking-[0.15px] text-muted">{ s.Tagline }</span>
					<span class="mt-1.5 flex items-center text-strong">
						@ui.Icon("map-pin", "h-[13px] w-[13px]")
						<span class="ml-1 truncate text-[11.5px] font-semibold">Local delivery</span>
					</span>
				</span>
			</a>
		}
	</div>
}

// _NothingHere.
templ nothingHere(scope string) {
	<div class="rounded-featured bg-surface p-7 text-center shadow-surface">
		@ui.Icon("store", "mx-auto h-[38px] w-[38px] text-strong")
		<h2 class="editorial-heading mt-4 text-[32px] text-text">{ tpl.When(scope != "", "Nothing in "+scope+" yet", "No shops open yet") }</h2>
		<p class="mt-[7px] text-body text-muted">{ tpl.When(scope != "", "Try another department, or open a store here yourself.", "The first local store to open will appear here.") }</p>
		<div class="mt-5">
			@ui.ActionButton("Open your store", true, templ.Attributes{"href": "/seller"})
		</div>
	</div>
}

// _HomeClose.
templ homeClose() {
	<div class="flex items-center rounded-featured bg-forest p-[22px] shadow-raised">
		<p class="editorial-heading flex-1 text-[32px] text-white md:text-[42px]">Local stores.<br/>Good things, close by.</p>
		@ui.TactileButton("arrow-up", "Back to top", 44, "#C6EE63", templ.Attributes{
			"x-data":     "",
			"x-on:click": "window.scrollTo({top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'})",
		})
	</div>
}

// jsonArg renders a Go value as a JS literal for an Alpine x-data call.
func jsonArg(v any) string {
	b, _ := json.Marshal(v)
	return string(b)
}

func searchHref(q, tab string) string {
	v := url.Values{}
	if q != "" {
		v.Set("q", q)
	}
	if tab != "" && tab != "All" {
		v.Set("tab", tab)
	}
	if len(v) == 0 {
		return "/search"
	}
	return "/search?" + v.Encode()
}

func tabHref(name string) string {
	if name == "All" {
		return "/"
	}
	return "/?tab=" + url.QueryEscape(name)
}

func storesHref(scope string) string {
	if scope == "" {
		return "/stores"
	}
	return "/stores?tab=" + url.QueryEscape(scope)
}

func campaignHref(c backend.Campaign, deptOf map[string]string) string {
	return searchHref(c.Category, deptOf[c.Category])
}

func bannerTag(c backend.Campaign) string {
	if c.Category == "" {
		return "THE LOCAL EDIT"
	}
	return strings.ToUpper(c.Category)
}

func bannerWash(bg string) string {
	return "background-image:linear-gradient(to right," + bg + " 0%," + tpl.RGBA(bg, .98) + " 48%," +
		tpl.RGBA(bg, .42) + " 80%," + tpl.RGBA(bg, .04) + " 100%)"
}

func dwells(cs []backend.Campaign) []int {
	out := make([]int, len(cs))
	for i, c := range cs {
		out[i] = 6
		if shop.IsVideo(c.ImageURL) {
			out[i] = 12
		}
	}
	return out
}

func seasonHints(p viewdata.Page) []string {
	if p.Season != nil && p.Season.Hints != nil {
		return p.Season.Hints
	}
	return []string{}
}

func hintLabel(hints []string) string {
	if len(hints) == 0 {
		return "Search products, shops and more"
	}
	return "Search \"" + hints[0] + "\""
}

func addressText(p viewdata.Page) string {
	if p.Address == nil {
		return "Choose delivery location"
	}
	return shop.TitleCase(p.Address.Label) + " · " + p.Address.Line
}

func addressHref(p viewdata.Page) string {
	if p.User == nil {
		return "/login?next=/account"
	}
	return "/addresses"
}

func currentAttr(selected bool) templ.Attributes {
	if selected {
		return templ.Attributes{"aria-current": "page"}
	}
	return templ.Attributes{}
}

func oobAttrs(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return templ.Attributes{}
}

func firstProducts(items []backend.Product, n int) []backend.Product {
	if len(items) > n {
		return items[:n]
	}
	return items
}

func firstCategories(items []backend.Category, n int) []backend.Category {
	if len(items) > n {
		return items[:n]
	}
	return items
}
