server {
    server_name api.geltrax.engineer;

    client_max_body_size 64M;

    # Razorpay checkout is implemented by the storefront BFF. Keep these exact
    # routes ahead of the general backend API proxy.
    location = /api/create-order {
        proxy_pass http://127.0.0.1:8100;
        include proxy_params;
    }

    location = /api/verify-payment {
        proxy_pass http://127.0.0.1:8100;
        include proxy_params;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    location / {
        proxy_pass http://127.0.0.1:8100;
        include proxy_params;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/api.geltrax.engineer/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.geltrax.engineer/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.geltrax.engineer;
    return 301 https://$host$request_uri;
}
