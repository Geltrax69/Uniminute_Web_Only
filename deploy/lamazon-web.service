[Unit]
Description=Lamazon Go storefront
After=network-online.target lamazon-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/Lamazon
EnvironmentFile=/var/www/Lamazon/.env.systemd
ExecStart=/usr/bin/env PORT=8100 API_BASE=http://127.0.0.1:8081 /var/www/Lamazon/bin/lamazon-web
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
