{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lamazon-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a && . ./.env && set +a && cd backend && go run ."
      ],
      "port": 8080,
      "url": "http://localhost:8080"
    },
    {
      "name": "lamazon-website",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd Lamazon_website && ~/go/bin/templ generate && npm run build && API_BASE=https://api.geltrax.engineer go run ."
      ],
      "port": 8100,
      "url": "http://localhost:8100"
    },
    {
      "name": "lamazon-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend && flutter run -d web-server --web-port 8766 --web-hostname 0.0.0.0"
      ],
      "port": 8766,
      "url": "http://localhost:8766"
    },
    {
      "name": "lamazon-release",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend/build/web && python3 -m http.server 8767"
      ],
      "port": 8767,
      "url": "http://localhost:8767"
    }
  ]
}